#!/bin/sh

# cawk is subject to a MIT open-source licence
# please refer to the MIT licence file for further information
#
# this program checks if the main tools are available
# and if the system is ready to run cawk

echo ""
echo "cawk system check"
echo "=================================="
echo ""

total=0
available=0

check_tool() {
    tool=$1
    if command -v "$tool" >/dev/null 2>&1; then
        echo "  ✅ $tool"
        available=$((available + 1))
    else
        echo "  ❌ $tool"
    fi
    total=$((total + 1))
}

echo "ESSENTIALS (required for cawk):"
check_tool "gawk"
check_tool "gmake"
check_tool "m4"
echo ""

echo "SUPPORT (recommended):"
check_tool "sed"
check_tool "find"
check_tool "grep"
check_tool "diff"
check_tool "mktemp"
check_tool "sha512sum"
echo ""

echo "OPTIONAL (advanced features):"
check_tool "tar"
check_tool "gzip"
check_tool "mutt"
echo ""

echo "=================================="
echo "Summary: $available/$total tools available"
if [ "$available" = "$total" ]; then
    echo "✅ cawk is ready to use"
else
    echo "⚠️  Some tools are missing"
fi
echo ""
