.PHONY: \
  help version

help:
	$(ECHO) ""
	$(ECHO) ""
	$(ECHO) "  ###    ###   #   #  #   #"
	$(ECHO) " #      #   #  #   #  #  # "
	$(ECHO) " #      #####  # # #  ###  "
	$(ECHO) " #      #   #  ## ##  #  # "
	$(ECHO) "  ###   #   #  #   #  #   #"
	$(ECHO) "  network configuration compliance checker and censor ($(CAWK_RELEASE))"
	$(ECHO) ""
	$(ECHO) ""
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK INFO --------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# note : %SED_GAWK_PATH% point out the gawk path, we set <!/usr/bin/env -S gawk -f> (ref support/tests.sed)"
	$(ECHO) "# note : Makefile.support.mk contains variables that can change the cawk behavior"
	$(ECHO) "# note : you can have several targets for a same $(GMAKE) call like -> $(GMAKE) clean check_repo view_repo"
	$(ECHO) "# note : <repo> is the original cawk repository of coded tests, test's confs and exceptions"
	$(ECHO) "# note : <run> is an empty repository used for your own tests/checks"
	$(ECHO) "# note : <run_AUDIT_NAME> are repositories for all of your contexts or for your customers"
	$(ECHO) "# note : please refer to the README file for further information"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK VERSION------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) version : provide information on cawk release"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK MAIN --------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) : provide information on cawk running"
	$(ECHO) "# $(GMAKE) check : allow to run a cawk compliance check (result must be OK only after the first installation)"
	$(ECHO) "# $(GMAKE) system : allow to know if the system can run cawk"
	$(ECHO) "# $(GMAKE) supplier : provide the suppliers supported by cawk"
	$(ECHO) "# $(GMAKE) common : provide the list of functions available in the common dir"
	$(ECHO) "# $(GMAKE) clean : clean tests && tmp repository"
	$(ECHO) "# $(GMAKE) clean_tmp : remove the temporary files of the tmp dir (tmp*, conf_*, Makefile*, *.swap)"
	$(ECHO) "# $(GMAKE) archive_repo / archive_run / archive_run audit=AUDIT_NAME : archive current .csv/.txt reports into a dated .tar.gz (auto-called at the end of check_repo/check_run)"
	$(ECHO) "# $(GMAKE) archive_run_audit : archive the reports of all AUDIT_NAMEs"
	$(ECHO) "# $(GMAKE) clean_report_repo / clean_report_run / clean_report_run audit=AUDIT_NAME : clean reports"
	$(ECHO) "# $(GMAKE) clean_report_run_audit : clean reports for all AUDIT_NAMEs"
	$(ECHO) "# $(GMAKE) clean_archive_repo / clean_archive_run / clean_archive_run audit=AUDIT_NAME : clean archives"
	$(ECHO) "# $(GMAKE) clean_archive_run_audit : clean archives for all AUDIT_NAMEs"
	$(ECHO) "# $(GMAKE) clean_archive_older : clean older archives (ref ARCHIVE_OLDER_DAYS variable in Makefile.support.mk)"
	$(ECHO) "# $(GMAKE) clean_logs : (FORCE=yes required) clean all logs (all scopes, not run automatically by clean/clean_force)"
	$(ECHO) "# $(GMAKE) clean_logs_repo / clean_logs_run / clean_logs_run audit=AUDIT_NAME : (FORCE=yes required) clean logs for one scope"
	$(ECHO) "# $(GMAKE) clean_logs_run_audit : (FORCE=yes required) clean logs for all AUDIT_NAMEs"
	$(ECHO) "# $(GMAKE) clean_backup : clean all backups"
	$(ECHO) "# $(GMAKE) clean_orig : (FORCE=yes required) clean all backup files with .orig suffix"
	$(ECHO) "# $(GMAKE) clean_orig_info : list all .orig backup files present in the repo"
	$(ECHO) "# $(GMAKE) clean_force : (FORCE=yes required, USE WITH CAUTION) clean all including reports, backups, archives, censored confs for all assessments"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK ASSESSMENT --------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) create_audit audit=AUDIT_NAME : create full AUDIT_NAME (all suppliers)"
	$(ECHO) "# $(GMAKE) create_audit audit=AUDIT_NAME supplier=SUPPLIER : add SUPPLIER to existing AUDIT_NAME"
	$(ECHO) "# $(GMAKE) delete_audit audit=AUDIT_NAME : delete full AUDIT_NAME (all suppliers)"
	$(ECHO) "# $(GMAKE) delete_audit audit=AUDIT_NAME supplier=SUPPLIER : remove SUPPLIER from AUDIT_NAME"
	$(ECHO) "# $(GMAKE) list_audit : list all the AUDIT_NAMEs (audit=AUDIT_NAME)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK SYNC --------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE    : only available for audit=AUDIT_NAME assessment"
	$(ECHO) "# NOTE    : it relies on the cawk sync database (see README)"
	$(ECHO) "# CAUTION : local confs files are removed during sync (confs/run_audit dir) (see README)"
	$(ECHO) "# $(GMAKE) sync_run audit=AUDIT_NAME : build inventory and sync confs from a central repository to confs/run_audit dir"
	$(ECHO) "# $(GMAKE) sync_run_audit : build inventory and sync confs from a central repository to all confs/run_audit dirs"
	$(ECHO) "# $(GMAKE) sync_psirt : build psirt inventory to be used by psirt tests"
	$(ECHO) "# $(GMAKE) sync_teststoconfs_run : sync tests to confs for audit=AUDIT_NAME assessment"
	$(ECHO) "# $(GMAKE) sync_teststoconfs_run_audit : sync tests to confs for only all audit=AUDIT_NAME assessments"
	$(ECHO) "# $(GMAKE) sync_exceptionstoconfs_run audit=AUDIT_NAME : sync exceptions to confs for audit=AUDIT_NAME assessment"
	$(ECHO) "# $(GMAKE) sync_exceptionstoconfs_run_audit : sync exceptions to confs for all audit=AUDIT_NAME assessments"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK COLLECT (optional config collectors: scp, rsync, local) ------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE    : collectors are external scripts (database/collectors), they only fill confs/collect_audit (see README)"
	$(ECHO) "# NOTE    : the sync database sync_paths must reference ../collect_AUDIT_NAME/ to sync the collected confs"
	$(ECHO) "# $(GMAKE) database_collect_(add,update) audit=AUDIT_NAME collector=scp|rsync|local args=ARGS/none [sync=yes] : add/update the collector of AUDIT_NAME"
	$(ECHO) "# $(GMAKE) database_collect_del audit=AUDIT_NAME : delete the collector of AUDIT_NAME"
	$(ECHO) "# $(GMAKE) database_collect_sync audit=AUDIT_NAME : reference confs/collect_AUDIT_NAME in the sync database"
	$(ECHO) "# $(GMAKE) database_view_collect : view only the cawk collect database"
	$(ECHO) "# $(GMAKE) collect_run audit=AUDIT_NAME : run the collector of AUDIT_NAME"
	$(ECHO) "# $(GMAKE) collect_run_audit : run the collectors of all the audits"
	$(ECHO) "# $(GMAKE) sync_run audit=AUDIT_NAME COLLECT=yes : collect then sync"
	$(ECHO) "# $(GMAKE) check_collect : non-regression of the collectors (no network)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK TESTS -------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---- tests compile ----"
	$(ECHO) "# $(GMAKE) tests_common : build tests associated to common dir"
	$(ECHO) "# $(GMAKE) tests_repo : build tests associated to repo dir"
	$(ECHO) "# $(GMAKE) tests_run : build tests associated to run dir"
	$(ECHO) "# $(GMAKE) tests_run audit=AUDIT_NAME : build tests associated to run_audit dir"
	$(ECHO) "# $(GMAKE) tests_run_audit : build tests associated to all audit=AUDIT_NAME run_audit dirs"
	$(ECHO) "# $(GMAKE) tests_target_common / tests_target_repo / tests_target_run : build only the compiled files of common / repo / run (prerequisites of the other targets)"
	$(ECHO) "# $(GMAKE) database_target_sh : build the database scripts (database/scripts/*.script) from their .script.sh source"
	$(ECHO) "# ---- tests copy----"
	$(ECHO) "# $(GMAKE) tests_run_copy audit=AUDIT_NAME : copy tests from repo to audit=AUDIT_NAME - overwrite (ref run_audit)"
	$(ECHO) "# $(GMAKE) tests_run_audit_copy : copy tests from repo to all audit=AUDIT_NAMEs (ref all run_audit)"
	$(ECHO) "# ---- tests check----"
	$(ECHO) "# $(GMAKE) tests_check : check if the tests are cawk compliant, all cawk pass and cawk error are displayed"
	$(ECHO) "# $(GMAKE) tests_check_nok : check if the tests are cawk compliant, only cawk error are displayed"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK EXCEPTIONS --------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---- exceptions compile ----"
	$(ECHO) "# $(GMAKE) exceptions_repo : build exceptions from repo/.m4 files (automatically called by check_repo)"
	$(ECHO) "# $(GMAKE) exceptions_run : build exceptions from run/.m4 files (automatically called by check_run)"
	$(ECHO) "# $(GMAKE) exceptions_run_audit : build exceptions of all audit=AUDIT_NAMEs"
	$(ECHO) "# ---- exceptions copy ----"
	$(ECHO) "# $(GMAKE) exceptions_run audit=AUDIT_NAME : build exceptions from run_audit/.m4 files (automatically called by check_run audit=AUDIT_NAME)"
	$(ECHO) "# $(GMAKE) exceptions_run_copy audit=AUDIT_NAME : copy exceptions from repo to audit=AUDIT_NAME (no overwrite, preserves existing)"
	$(ECHO) "# $(GMAKE) exceptions_run_audit_copy : copy exceptions from repo to all audit=AUDIT_NAMEs (no overwrite)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK CHECK -------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE : PSIRT_ONLY=yes (run ONLY psirt tests), STANDARD_ONLY=yes (run ONLY standard tests, skip psirt), DEADBEEF=yes, SECRETSCAN=yes (censored csv reports), BADFORMAT=yes, CRLF=no, etc. can be added to the $(GMAKE) call to change the assessment scope/behavior"
	$(ECHO) "# $(GMAKE) check_repo : assess the confs with <repo> tests (build tests if not)"
	$(ECHO) "#  or $(GMAKE) check_repo (run all suppliers)"
	$(ECHO) "#  or $(GMAKE) check_repo supplier=cisco-ios (or juniper-junos, etc.)"
	$(ECHO) "# $(GMAKE) check_run : assess the confs with <run> tests (build tests if not)"
	$(ECHO) "#  or $(GMAKE) check_run (run all suppliers)"
	$(ECHO) "#  or $(GMAKE) check_run supplier=cisco-ios (or juniper-junos, etc.)"
	$(ECHO) "#  or $(GMAKE) check_run audit=AUDIT_NAME (run all suppliers)"
	$(ECHO) "#  or $(GMAKE) check_run supplier=cisco-ios audit=AUDIT_NAME (or juniper-junos, etc.)"
	$(ECHO) "# $(GMAKE) check_run_audit : run assessments for all the audit=AUDIT_NAMEs"
	$(ECHO) "# $(GMAKE) check_supplier : validate supplier=, audit= and the options (yes/no, numbers), prerequisite of the check/view/censor targets"
	$(ECHO) "# $(GMAKE) check_deprecated_repo / check_deprecated_run : fail when a test of repo / run uses an obsolete function"
	$(ECHO) "# ---- cawk integrity check (see gmake check) ----"
	$(ECHO) "# $(GMAKE) check_parallel : same as check with MAKE_PARALLEL=yes"
	$(ECHO) "# $(GMAKE) check_checkdiff : build the checkdiff scripts (prerequisite of the check_debug* and check_analyze targets)"
	$(ECHO) "# $(GMAKE) check_debug / check_parallel_debug : run the integrity check in debug mode (sequential / parallel)"
	$(ECHO) "# $(GMAKE) check_debug_log : run the integrity check and write checkdiff/checkdiff_log.txt"
	$(ECHO) "# $(GMAKE) check_analyze : analyze the differences of the last debug run into checkdiff/checkdiff_report.txt"
	$(ECHO) "# $(GMAKE) check_update : (CAUTION) accept the current result as the new checkdiff reference (checkdiff.old)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK VIEW --------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) view_repo : view the repo reports (all in report/repo dir)"
	$(ECHO) "#  or $(GMAKE) view_repo supplier=cisco-ios (or juniper-junos, etc.)"
	$(ECHO) "# $(GMAKE) view_repo_error : view the repo assessment reports errors (all in report/repo dir)"
	$(ECHO) "#  or $(GMAKE) view_repo_error supplier=cisco-ios (or juniper-junos, etc.)"
	$(ECHO) "# $(GMAKE) view_run : view the run reports (all in report/run or run_audit dirs)"
	$(ECHO) "#  or $(GMAKE) view_run supplier=cisco-ios (or juniper-junos, etc.)"
	$(ECHO) "#  or $(GMAKE) view_run supplier=cisco-ios audit=AUDIT_NAME (or juniper-junos, etc.)"
	$(ECHO) "# $(GMAKE) view_run_error : view the run assessment reports errors (all in report/run or run_audit dirs)"
	$(ECHO) "#  or $(GMAKE) view_run_error audit=AUDIT_NAME (all in report/run_audit dir)"
	$(ECHO) "#  or $(GMAKE) view_run_error supplier=cisco-ios audit=AUDIT_NAME (or juniper-junos, etc.)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK EMAIL -------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE : only available for audit=AUDIT_NAME assessment"
	$(ECHO) "# $(GMAKE) email_send audit=AUDIT_NAME : send an email to the audit list of emails"
	$(ECHO) "# $(GMAKE) email_send_audit : send an email to all audits list of emails"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK POST AUDIT --------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE : only available for audit=AUDIT_NAME assessment"
	$(ECHO) "# $(GMAKE) postaudit_run audit=AUDIT_NAME : run database/scripts/database_postaudit.script for audit=AUDIT_NAME (skipped if the script does not exist)"
	$(ECHO) "# $(GMAKE) postaudit_run_audit : run database/scripts/database_postaudit.script for all audit=AUDIT_NAMEs in the cawk post audit database"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK BACKUP AND RESTORE ------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE : only available for audit=AUDIT_NAME assessment"
	$(ECHO) "# $(GMAKE) backup_run audit=AUDIT_NAME : backup all data linked to audit=AUDIT_NAME in backup dir"
	$(ECHO) "# $(GMAKE) restore_run audit=AUDIT_NAME file=BACKUP_PATH_FILE : restore all data from file_path"
	$(ECHO) "# $(GMAKE) backup_run_audit : backup cawk database and all data linked to all audit=AUDIT_NAMEs in backup dir"
	$(ECHO) "# $(GMAKE) restore_run_audit file=BACKUP_PATH_FILE : restore database and all data from file_path"
	$(ECHO) "# $(GMAKE) migrate file=BACKUP_PATH_FILE : run several targets to migrate to a new cawk version (see README)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK DATABASE ----------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# NOTE : only available for audit=AUDIT_NAME assessments"
	$(ECHO) "# $(GMAKE) database_view : view all the databases linked to audit=AUDIT_NAME assessments"
	$(ECHO) "# ---- sync ----"
	$(ECHO) "# $(GMAKE) database_view_sync : view only the cawk sync database"
	$(ECHO) "# $(GMAKE) database_sync_(add,update) audit=AUDIT_NAME dir=SYNC_PATH regexinventory=REGEX_PATTERN/.* scope=SCOPE_FILE/none"
	$(ECHO) "#   regexos=REGEX_PATTERN/.* regexpathexclude=REGEX_PATTERN/none regexinventoryexclude=REGEX_PATTERN/none"
	$(ECHO) "#  add/update an entry in the cawk sync database, where fields are separated by spaces :"
	$(ECHO) "#   - 1 field is the audit name"
	$(ECHO) "#   - 2 field is the various sync paths separated by comma (no space) like /conf/ or /conf/cawk/,/conf/cawk_2/"
	$(ECHO) "#   - 3 field is an extended regex to select inventory (field 4) lines pattern matching like .* or .*switch.*"
	$(ECHO) "#     (only applied when field 4 is set to an actual scope file, ignored when scope=none)"
	$(ECHO) "#   - 4 field is a file containing a list of devices matching a device scope based on internal inventory"
	$(ECHO) "#   - 5 field is an extended regex to select os pattern matching like (cisco-ios|cisco-xe) or .*"
	$(ECHO) "#   - 6 field is an extended regex to exclude device path or device name pattern matching like (_home|_earth) or none"
	$(ECHO) "#   - 7 field is an extended regex to exclude inventory (field 4) lines pattern matching, same restriction as field 3"
	$(ECHO) "# $(GMAKE) database_sync_del audit=AUDIT_NAME : delete an entry in the cawk sync database"
	$(ECHO) "# ---- email ----"
	$(ECHO) "# $(GMAKE) database_view_email : view only the cawk email database"
	$(ECHO) "# $(GMAKE) database_email_(add,update) audit=AUDIT_NAME dst=EMAIL_LIST cc=EMAIL_LIST/none"
	$(ECHO) "#  add/update an entry in the cawk email database, where fields are separated by spaces :"
	$(ECHO) "#   - 1 field is the audit name"
	$(ECHO) "#   - 2 field is the dst list of emails separated by comma (no space) like email1,email2,email3"
	$(ECHO) "#   - 3 field is the cc list of emails separated by comma (no space) like email1,email2,email3 or none"
	$(ECHO) "# $(GMAKE) database_email_del audit=AUDIT_NAME : delete an entry in the cawk email database"
	$(ECHO) "# ---- post audit ----"
	$(ECHO) "# $(GMAKE) database_view_postaudit : view only the cawk post audit database"
	$(ECHO) "# $(GMAKE) database_postaudit_(add/del/update) audit=AUDIT_NAME"
	$(ECHO) "#  add/delete an entry in the cawk post audit database, where fields are separated by spaces :"
	$(ECHO) "#   - 1 field is the audit name"
	$(ECHO) "# ---- information ----"
	$(ECHO) "# $(GMAKE) catalog_build : regenerate database/db_info.txt and database/db_nist_mappings.json (with CATALOG_BUILD=yes)"
	$(ECHO) "# $(GMAKE) catalog_build_repo / catalog_build_run / catalog_build_audit audit=AUDIT_NAME : refresh only the lines of repo / run / audit=AUDIT_NAME in database/db_info.txt"
	$(ECHO) "# $(GMAKE) catalog_nist_mappings : regenerate database/db_nist_mappings.json from database/db_info.txt"
	$(ECHO) "#  regenerate test metadata database from tests program metadata with fields separated by semicolons :"
	$(ECHO) "#   - 1 field is the assessment context (repo or audit name)"
	$(ECHO) "#   - 2 field is the supplier (vendor/platform)"
	$(ECHO) "#   - 3 field is the test name"
	$(ECHO) "#   - 4 field is the test purpose"
	$(ECHO) "#   - 5 field is the test description"
	$(ECHO) "#   - 6 field is the remediation actions"
	$(ECHO) "#   - 7 field is the NIST 800-53 reference"
	$(ECHO) "#   - 8 field is the risk level (high/medium/low/info)"
	$(ECHO) "#   - 9 field is the test authors"
	$(ECHO) "# ---- exceptions ----"
	$(ECHO) "# $(GMAKE) exceptions_build : regenerate database/db_exception.txt from all .m4 exception files"
	$(ECHO) "# $(GMAKE) exceptions_build_repo / exceptions_build_run / exceptions_build_run audit=AUDIT_NAME : add only the exceptions of repo / run / run_audit to database/db_exception.txt"
	$(ECHO) "#  regenerate exception database with fields separated by semicolons :"
	$(ECHO) "#   - 1 field is the assessment context (repo or audit name)"
	$(ECHO) "#   - 2 field is the supplier (vendor/platform)"
	$(ECHO) "#   - 3 field is the exception ID"
	$(ECHO) "#   - 4 field is the approver name"
	$(ECHO) "#   - 5 field is the date (yyyy-mm-dd format)"
	$(ECHO) "#   - 6 field is the business context/reason for the exception"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK CATALOG -----------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---- tests ----"
	$(ECHO) "# $(GMAKE) catalog_repo : build the tests description catalog for repo"
	$(ECHO) "# $(GMAKE) catalog_run : build the tests description catalog for run"
	$(ECHO) "# $(GMAKE) catalog_run audit=AUDIT_NAME: build the tests description catalog for audit=AUDIT_NAME"
	$(ECHO) "# $(GMAKE) catalog_build : build the tests description catalog for all assessments (repo and run_audit)"
	$(ECHO) "# ---- exceptions ----"
	$(ECHO) "# $(GMAKE) catalog_exceptions_repo : build the exceptions description catalog for repo"
	$(ECHO) "# $(GMAKE) catalog_exceptions_run : build the exceptions description catalog for run"
	$(ECHO) "# $(GMAKE) catalog_exceptions_run audit=AUDIT_NAME: build the exceptions description catalog for audit=AUDIT_NAME"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---- nist coverage ----"
	$(ECHO) "# $(GMAKE) nist_coverage_official : count the NIST 800-53 controls of the official benchmark (database/db_nist800-53.txt)"
	$(ECHO) "# $(GMAKE) nist_coverage_repo : NIST 800-53 coverage of the repo tests by supplier"
	$(ECHO) "# $(GMAKE) nist_coverage_run [audit=AUDIT_NAME] : NIST 800-53 coverage of the run (or run_audit) tests by supplier"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK ROLES -------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) roles_list : list the members of the cawk_admin group"
	$(ECHO) "# $(GMAKE) roles_perm : apply the cawk permissions (runs roles/cawk_perm with sudo)"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK GIT (release workflow, every target except gitcheck* needs FORCE=yes) ---------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# MODE 1 direct to master : gitinstallcicd -> gitcommit -> gitpush -> gitpushtag"
	$(ECHO) "# MODE 2 via a branch and a pull request : gitnewbranch -> gitcommit -> gitpushbranch -> gitpr -> gitprmerge -> gitmasterupdate -> gitpushtag"
	$(ECHO) "# $(GMAKE) gitcheck : release gate (databases, tests, system, directories, extensions, .orig files, orthogonality) after a clean_force"
	$(ECHO) "# $(GMAKE) gitcheck_orthogonality : check the consistency between the tests, confs and exceptions of the suppliers"
	$(ECHO) "# $(GMAKE) git_branch_master_check / git_branch_not_master_check : fail unless the current branch is / is not master"
	$(ECHO) "# $(GMAKE) gitinstallcicd FORCE=yes : copy cicd/*.yml into .github/workflows"
	$(ECHO) "# $(GMAKE) gitcommit FORCE=yes : git add and commit with the message *<CAWK_RELEASE> ref ChangeLog (CO_AUTHOR= adds a trailer)"
	$(ECHO) "# $(GMAKE) gitnewbranch FORCE=yes : create the branch <CAWK_RELEASE>-beta (from master)"
	$(ECHO) "# $(GMAKE) gitpush FORCE=yes : push master to origin"
	$(ECHO) "# $(GMAKE) gitpushbranch FORCE=yes : push the <CAWK_RELEASE>-beta branch to origin"
	$(ECHO) "# $(GMAKE) gitpr FORCE=yes : open the pull request of the current branch (gh)"
	$(ECHO) "# $(GMAKE) gitprmerge FORCE=yes : merge the pull request and delete the branch (gh)"
	$(ECHO) "# $(GMAKE) gitmasterupdate FORCE=yes : checkout and pull master"
	$(ECHO) "# $(GMAKE) gitpushtag FORCE=yes : tag <CAWK_RELEASE> and push the tag"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# -- CAWK CENSOR ------------------------------------------------------------------------------------------------"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"
	$(ECHO) "# $(GMAKE) censor_repo : censor confs/repo/confs.<supplier> into confs/repo/confs.<supplier>.censored"
	$(ECHO) "# $(GMAKE) censor_run : same for confs/run"
	$(ECHO) "# $(GMAKE) censor_run audit=AUDIT_NAME : same for confs/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) censor_run_audit : same for every named audit"
	$(ECHO) "# $(GMAKE) censor_file in=PATH_FILE out=PATH_FILE_OUT : censor one file into one file"
	$(ECHO) "# $(GMAKE) censor_stdout in=PATH_FILE : censor one file to the standard output"
	$(ECHO) "# $(GMAKE) censor_check in=PATH_FILE_OR_DIR : fail when a secret the regexes know is still there"
	$(ECHO) "# $(GMAKE) censor_logs_repo : censor logs/repo into logs/repo.censored"
	$(ECHO) "# $(GMAKE) censor_logs_run : same for logs/run"
	$(ECHO) "# $(GMAKE) censor_logs_run audit=AUDIT_NAME : same for logs/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) censor_logs_run_audit : same for every named audit"
	$(ECHO) "# $(GMAKE) censor_report_repo : censor reports/repo into reports/repo.censored (the reports hold conf lines)"
	$(ECHO) "# $(GMAKE) censor_report_run : same for reports/run"
	$(ECHO) "# $(GMAKE) censor_report_run audit=AUDIT_NAME : same for reports/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) censor_report_run_audit : same for every named audit"
	$(ECHO) "# $(GMAKE) clean_censor_repo : remove confs/repo/confs.<supplier>.censored"
	$(ECHO) "# $(GMAKE) clean_censor_run : same for confs/run"
	$(ECHO) "# $(GMAKE) clean_censor_run audit=AUDIT_NAME : same for confs/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) clean_censor_run_audit : same for every named audit"
	$(ECHO) "# $(GMAKE) clean_censor_logs_repo : remove logs/repo.censored"
	$(ECHO) "# $(GMAKE) clean_censor_logs_run : same for logs/run"
	$(ECHO) "# $(GMAKE) clean_censor_logs_run audit=AUDIT_NAME : same for logs/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) clean_censor_logs_run_audit : same for every named audit"
	$(ECHO) "# $(GMAKE) clean_censor_report_repo : remove reports/repo.censored"
	$(ECHO) "# $(GMAKE) clean_censor_report_run : same for reports/run"
	$(ECHO) "# $(GMAKE) clean_censor_report_run audit=AUDIT_NAME : same for reports/run_AUDIT_NAME"
	$(ECHO) "# $(GMAKE) clean_censor_report_run_audit : same for every named audit"
	$(ECHO) "# ---------------------------------------------------------------------------------------------------------------"

version:
