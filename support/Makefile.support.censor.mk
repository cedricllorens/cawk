ifeq ($(strip $(audit)),)
	$(call cawk_censor_dir,$(LOGS_PATH)/run)
	$(ECHO) "cawk censor_logs_run done ----"
else
	$(call cawk_censor_dir,$(LOGS_PATH)/run_$(audit))
	$(ECHO) "cawk censor_logs_run $(audit) done ----"
endif

censor_logs_run_audit: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@count=$$($(RUN_DIRS_FIND) | wc -l); \
	if [ "$$count" -eq 0 ]; then \
		$(ECHO) "cawk censor_logs_run_audit: no run audits found ----" ; \
	else \
		$(RUN_DIRS_FIND) | while read -r audit; do \
			$(GMAKE) censor_logs_run audit=$$audit || exit 1; \
		done ; \
	fi
	$(ECHO) "cawk censor_logs_run_audit done ----"

