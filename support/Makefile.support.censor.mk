# censoring of the configurations : confs/<context>/confs.<supplier> is copied, censored by
# common/censor.gawk, into confs/<context>/confs.<supplier>.censored
# the regexes are the ones of database/censor/censor_regex, built from censor_regex.m4 (the only file to edit) ;
# CENSOR_LEVEL=internal (default) applies the regexes of level internal, CENSOR_LEVEL=external also those of level external
#
# other usages of the same censor :
#   censor_file in=<file> out=<file>   one file censored into one file (CENSOR_OUT_FILE of common/censor.gawk)
#   censor_stdout in=<file>            one file censored to the standard output (preview, pipe)
#   censor_check in=<file|dir>         nothing is censored, the target fails when a secret the regexes
#                                      know is still there (CENSOR_MODE=check, the guard before sharing)
#   censor_logs_*                      logs/<context> copied, censored, into logs/<context>.censored
#   censor_report_*                    reports/<context> copied, censored, into reports/<context>.censored
#                                      (an assessment result line holds the configuration line it is about)

.PHONY: \
  censor_repo censor_run censor_run_audit \
  censor_file censor_stdout censor_check \
  censor_logs_repo censor_logs_run censor_logs_run_audit \
  censor_report_repo censor_report_run censor_report_run_audit

# the rules are generated by m4 as gawk code (database/censor/censor_regex.m4 -> censor_regex, included by common/censor.gawk) by the %: %.m4 rule
$(DATABASE_PATH)/censor/censor_regex: m4/cawk_censor.m4

# $(1) = confs directory of the assessment (confs/repo, confs/run or confs/run_<audit>)
# the censored directory is rebuilt each time so that it never keeps a configuration deleted at the source ;
# without supplier= the suppliers with no confs directory are skipped, with supplier= a missing directory is an error ;
# find batches the configurations itself, so that the recipe does not depend on their number (ARG_MAX)
define cawk_censor_confs
	@for s in $(if $(strip $(supplier)),$(supplier),$(SUPPLIER_SCOPE)); do \
		src="$(1)/confs.$$s"; \
		dst="$$src.censored"; \
		if [ ! -d "$$src" ]; then \
			[ -z "$(strip $(supplier))" ] && continue; \
			$(ECHO) "cawk error: $$src directory does not exist ----"; exit 1; \
		fi; \
		$(RM) -r "$$dst"; \
		mkdir -p "$$dst"; \
		CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_OUT_DIR="$$dst" find "$$src" -maxdepth 1 \( -type f -o -type l \) -exec $(TESTS_COMMON_PATH)/censor.gawk {} + \
			|| { $(ECHO) "cawk error: censor failed on $$src ----"; exit 1; }; \
		$(ECHO) "cawk censor $$src -> $$dst ($$(find "$$dst" -maxdepth 1 -type f | wc -l) configurations, CENSOR_LEVEL=$(strip $(CENSOR_LEVEL))) ----"; \
	done
endef

# $(1) = directory holding the files to censor (logs/repo, reports/run, ...) : copied, censored, into $(1).censored
# the censored directory is rebuilt each time so that it never keeps a file deleted at the source ;
# find batches the files itself, so that the recipe does not depend on their number (ARG_MAX)
define cawk_censor_dir
	@if [ ! -d "$(1)" ]; then \
		$(ECHO) "cawk error: $(1) directory does not exist ----"; exit 1; \
	fi
	$(RM) -f -r "$(1).censored"
	mkdir -p "$(1).censored"
	CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_OUT_DIR="$(1).censored" find "$(1)" -maxdepth 1 \( -type f -o -type l \) -exec $(TESTS_COMMON_PATH)/censor.gawk {} + \
		|| { $(ECHO) "cawk error: censor failed on $(1) ----"; exit 1; }
	$(ECHO) "cawk censor $(1) -> $(1).censored ($$(find "$(1).censored" -maxdepth 1 -type f | wc -l) files, CENSOR_LEVEL=$(strip $(CENSOR_LEVEL))) ----"
endef

censor_repo: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@if [ ! -d "$(CONFS_PATH)/repo" ]; then \
		$(ECHO) "cawk error: $(CONFS_PATH)/repo directory does not exist ----" ; \
		exit 1 ; \
	fi
	$(call cawk_censor_confs,$(CONFS_PATH)/repo)
	$(ECHO) "cawk censor_repo done ----"

censor_run: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
ifeq ($(strip $(audit)),)
	@if [ ! -d "$(CONFS_PATH)/run" ]; then \
		$(ECHO) "cawk error: $(CONFS_PATH)/run directory does not exist ----" ; \
		exit 1 ; \
	fi
	$(call cawk_censor_confs,$(CONFS_PATH)/run)
	$(ECHO) "cawk censor_run done ----"
else
	@if [ ! -d "$(CONFS_PATH)/run_$(audit)" ]; then \
		$(ECHO) "cawk error: $(CONFS_PATH)/run_$(audit) directory does not exist ----" ; \
		exit 1 ; \
	fi
	$(call cawk_censor_confs,$(CONFS_PATH)/run_$(audit))
	$(ECHO) "cawk censor_run $(audit) done ----"
endif

censor_run_audit: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@count=$$($(RUN_DIRS_FIND) | wc -l); \
	if [ "$$count" -eq 0 ]; then \
		$(ECHO) "cawk censor_run_audit: no run audits found ----" ; \
	else \
		$(RUN_DIRS_FIND) | while read -r audit; do \
			$(GMAKE) censor_run audit=$$audit || exit 1; \
		done ; \
	fi
	$(ECHO) "cawk censor_run_audit done ----"

# censor_file in=<file> out=<file> : one file censored into one file, out must differ from in
# (the output file is truncated before the input file is read, censoring in place would destroy it)
censor_file: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@if [ -z "$(strip $(in))" ] || [ -z "$(strip $(out))" ]; then \
		$(ECHO) "cawk error: censor_file needs in=PATH_FILE and out=PATH_FILE_OUT ----"; \
		exit 1; \
	fi
	@if [ ! -f "$(strip $(in))" ]; then \
		$(ECHO) "cawk error: $(strip $(in)) file does not exist ----"; \
		exit 1; \
	fi
	@if [ "$(strip $(in))" = "$(strip $(out))" ]; then \
		$(ECHO) "cawk error: censor_file out= must differ from in= ----"; \
		exit 1; \
	fi
	CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_OUT_FILE="$(strip $(out))" $(TESTS_COMMON_PATH)/censor.gawk "$(strip $(in))" \
		|| { $(ECHO) "cawk error: censor failed on $(strip $(in)) ----"; exit 1; }
	$(ECHO) "cawk censor $(strip $(in)) -> $(strip $(out)) (CENSOR_LEVEL=$(strip $(CENSOR_LEVEL))) ----"

# censor_stdout in=<file> : one file censored to the standard output (preview, pipe)
censor_stdout: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@if [ -z "$(strip $(in))" ]; then \
		$(ECHO) "cawk error: censor_stdout needs in=PATH_FILE ----"; \
		exit 1; \
	fi
	@if [ ! -f "$(strip $(in))" ]; then \
		$(ECHO) "cawk error: $(strip $(in)) file does not exist ----"; \
		exit 1; \
	fi
	CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_OUT_FILE=/dev/stdout $(TESTS_COMMON_PATH)/censor.gawk "$(strip $(in))" \
		|| { $(ECHO) "cawk error: censor failed on $(strip $(in)) ----"; exit 1; }

# censor_check in=<file|dir> : exit 1 when a file (or one file of the directory) still holds a text the
# regexes would censor at the level CENSOR_LEVEL : the guard run before sharing a file or a censored directory
censor_check: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	@if [ -z "$(strip $(in))" ]; then \
		$(ECHO) "cawk error: censor_check needs in=PATH_FILE_OR_DIR ----"; \
		exit 1; \
	fi
	@if [ ! -e "$(strip $(in))" ]; then \
		$(ECHO) "cawk error: $(strip $(in)) does not exist ----"; \
		exit 1; \
	fi
	@bad=$$(find "$(strip $(in))" -maxdepth 1 \( -type f -o -type l \) ! -readable -print 2>/dev/null | head -n 1); \
	if [ -n "$$bad" ]; then \
		$(ECHO) "cawk error: censor_check cannot read $$bad (dangling link or permission) ----"; \
		exit 1; \
	fi
	@if [ -d "$(strip $(in))" ]; then \
		CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_MODE=check find "$(strip $(in))" -maxdepth 1 \( -type f -o -type l \) -exec $(TESTS_COMMON_PATH)/censor.gawk {} + \
			|| { $(ECHO) "cawk error: censor_check found a secret in $(strip $(in)) ----"; exit 1; }; \
	else \
		CENSOR_LEVEL="$(strip $(CENSOR_LEVEL))" CENSOR_MODE=check $(TESTS_COMMON_PATH)/censor.gawk "$(strip $(in))" \
			|| { $(ECHO) "cawk error: censor_check found a secret in $(strip $(in)) ----"; exit 1; }; \
	fi
	$(ECHO) "cawk censor_check $(strip $(in)) done ----"

censor_logs_repo: check_supplier tests_target_common $(DATABASE_PATH)/censor/censor_regex
	$(call cawk_censor_dir,$(LOGS_PATH)/repo)
	$(ECHO) "cawk censor_logs_repo done ----"

