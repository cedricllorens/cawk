#%SED_GAWK_PATH%

# ------------------------------------------------------------
# cawk is subject to a MIT open-source licence
# please refer to the MIT licence file for further information
#
# it lists the exceptions of a supplier with database information
# and groups exceptions by source file comment
# ------------------------------------------------------------

BEGIN {
    FS = ";"
    db_file = "database/db_exception.txt"

    if (ARGC < 3) {
        print "Usage: gawk -f catalog_exceptions_info.gawk [audit] [supplier]"
        exit 1
    }

    target_audit = ARGV[1]
    target_supplier = ARGV[2]
    delete ARGV[1]
    delete ARGV[2]

    detailed_report(target_audit, target_supplier)
}

function detailed_report(audit, supplier) {
    print "=== audit:" audit " supplier:" supplier " list of exceptions ==="
    print ""
    catalog_exceptions_by_source(audit, supplier)
}

function catalog_exceptions_by_source(audit, supplier,    exc_dir, cmd, file) {
    exc_dir = ""
    if (audit == "repo") {
        exc_dir = "exceptions/repo"
    } else {
        exc_dir = "exceptions/run_" audit
    }

    cmd = "find " exc_dir " -type f \\( -name 'exceptions." supplier ".m4' -o -name 'exceptions." supplier ".template' -o -name 'exceptions." supplier ".include' \\) 2>/dev/null | sort"

    while ((cmd | getline file) > 0) {
        parse_exception_file(file, audit, supplier)
    }
    close(cmd)
}

function parse_exception_file(file, audit, supplier,    line, current_comment, current_id, current_approver, current_date, header_printed) {
    current_comment = ""
    current_id = ""
    current_approver = ""
    current_date = ""
    header_printed = 0

    while ((getline line < file) > 0) {
        if (line ~ /^dnl @exception_id:/) {
            if (header_printed && current_id != "") {
                print ""
            }
            sub(/^dnl @exception_id:[ \t]*/, "", line)
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            current_id = line
            header_printed = 0
        }
        else if (line ~ /^dnl @approver:/) {
            sub(/^dnl @approver:[ \t]*/, "", line)
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            current_approver = line
        }
        else if (line ~ /^dnl @date:/) {
            sub(/^dnl @date:[ \t]*/, "", line)
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            current_date = line
        }
        else if (line ~ /^dnl @reason:/) {
            sub(/^dnl @reason:[ \t]*/, "", line)
            gsub(/^[ \t]+|[ \t]+$/, "", line)
            current_comment = line
        }
        else if (line ~ /cawk_exception\(/) {
            if (current_id != "") {
                if (!header_printed) {
                    printf "[%s] %s (approver: %s, date: %s)\n", current_id, current_comment, current_approver, current_date
                    header_printed = 1
                }
                print "  " line
            }
        }
    }
    close(file)
}
