# 128-bit strings of zeros and ones: a /p range is a substr of them, not a bit loop
function cawk_bits_init() {
    if ( cawk_zeros128 != "" ) return
    cawk_zeros128 = sprintf("%128s", "")
    gsub(/ /, "0", cawk_zeros128)
    cawk_ones128 = cawk_zeros128
    gsub(/0/, "1", cawk_ones128)
}

# network mask of a /prefix as a bit string: prefix ones then zeros up to total_bits (32 or 128)
function cawk_cidrNetworkMask(cidr, total_bits,    prefix_length) {
    cawk_bits_init()
    prefix_length = int(cidr)
    return substr(cawk_ones128, 1, prefix_length) substr(cawk_zeros128, 1, total_bits - prefix_length)
}

# host mask of a /prefix as a bit string: prefix zeros then ones up to total_bits (32 or 128)
function cawk_cidrHostMask(cidr, total_bits,    prefix_length) {
    cawk_bits_init()
    prefix_length = int(cidr)
    return substr(cawk_zeros128, 1, prefix_length) substr(cawk_ones128, 1, total_bits - prefix_length)
}

function cawk_netMaskToBinary(netmask,    octets, binary, netmask_j) {
    split(netmask, octets, ".")
    binary = ""
    for (netmask_j = 1; netmask_j <= 4; netmask_j++) {
        binary = binary cawk_decToBin(octets[netmask_j])
    }
    return binary
}

function cawk_netMaskInv(netmask,    octets, maskInv, netmaskinv_j) {
    if ( netmask == "any" ) return netmask
    if ( netmask == "" ) return "any"
	if ( netmask == "0.0.0.0" ) return "host"
    split(netmask, octets, ".")
    for (netmaskinv_j = 1; netmaskinv_j <= 4; netmaskinv_j++) {
	maskInv[netmaskinv_j] = 255 - octets[netmaskinv_j]
    }
    return maskInv[1] "." maskInv[2] "." maskInv[3] "." maskInv[4]
}

function cawk_hostMaskToBinary(netmask,    octets, binary, hostmask_j) {
    split(netmask, octets, ".")
    binary = ""
    for (hostmask_j = 1; hostmask_j <= 4; hostmask_j++) {
        binary = binary cawk_decToBin(255-octets[hostmask_j])
    }
    return binary
}

# 1 when the string is a dotted quad of 0-255 decimal octets
function cawk_isDottedQuad(addr,    octets) {
    if ( addr !~ /^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$/ ) return 0
    split(addr, octets, ".")
    return ( octets[1] <= 255 && octets[2] <= 255 && octets[3] <= 255 && octets[4] <= 255 )
}

# 32-bit binary string of an ipv4 address, "" when it is not a dotted quad (object name, octet > 255)
function cawk_ipToBinary(ip_address,    octets, binary, ipToBinary_i) {
    if ( !cawk_isDottedQuad(ip_address) ) return ""
    split(ip_address, octets, ".")
    binary = ""
    for (ipToBinary_i = 1; ipToBinary_i <= 4; ipToBinary_i++) {
        binary = binary cawk_decToBin(octets[ipToBinary_i] + 0)
    }
    return binary
}

# decimal value of one hexadecimal group, -1 on an invalid digit
function cawk_hexToDec(hex,    hexToDec_i, digit, decimal) {
    decimal = 0
    for (hexToDec_i = 1; hexToDec_i <= length(hex); hexToDec_i++) {
        digit = index("0123456789abcdef", tolower(substr(hex, hexToDec_i, 1))) - 1
        if ( digit < 0 ) return -1
        decimal = decimal * 16 + digit
    }
    return decimal
}

# expand an ipv6 address to its full 8-group form: :: is filled with zero groups and an
# embedded ipv4 tail (::ffff:192.0.2.1) becomes two hex groups; returns "" when the address
# holds no :: and not exactly 8 groups (unparsable, the rule will not be assessed)
function cawk_ipv6Expand(addr,    groups, filled, v4parts, expand_i, expand_n, expand_ne) {
    if ( match(addr, /[0-9]+(\.[0-9]+){3}$/) ) {
        split(substr(addr, RSTART), v4parts, ".")
        if ( v4parts[1] > 255 || v4parts[2] > 255 || v4parts[3] > 255 || v4parts[4] > 255 ) return ""
        addr = substr(addr, 1, RSTART - 1) sprintf("%x:%x", v4parts[1] * 256 + v4parts[2], v4parts[3] * 256 + v4parts[4])
    }

    # strict syntax: one :: at most, no ::: nor single leading/trailing colon, groups of 1 to 4 hex digits
    if ( addr ~ /:::/ || addr ~ /^:[^:]/ || addr ~ /[^:]:$/ ) return ""
    if ( split(addr, groups, "::") > 2 ) return ""

    expand_n = split(addr, groups, ":")
    expand_ne = 0
    for (expand_i = 1; expand_i <= expand_n; expand_i++) {
        if ( groups[expand_i] == "" ) continue
        if ( groups[expand_i] !~ /^[0-9A-Fa-f]{1,4}$/ ) return ""
        expand_ne++
    }
    if ( expand_ne > 8 || ( addr ~ /::/ && expand_ne > 7 ) ) return ""
    if ( expand_ne == 8 && addr !~ /::/ ) return addr

    if ( addr !~ /::/ ) return ""

    # one :: only, filled so the address holds 8 groups
    filled = ""
    for (expand_i = 1; expand_i <= expand_n; expand_i++) {
        if ( groups[expand_i] == "" ) {
            while ( expand_ne < 8 ) {
                if ( filled != "" ) filled = filled ":"
                filled = filled "0"
                expand_ne++
            }
        } else {
            if ( filled != "" ) filled = filled ":"
            filled = filled groups[expand_i]
        }
    }
    while ( expand_ne < 8 ) {
        if ( filled != "" ) filled = filled ":"
        filled = filled "0"
        expand_ne++
    }
    return filled
}

# 128-bit binary string of an ipv6 address, "" when the address cannot be expanded
function cawk_ipv6ToBinary(ip_address,    groups, v6ToBin_i, v6ToBin_n, v6ToBin_v, v6ToBin_e, v6ToBin_b) {
    v6ToBin_e = cawk_ipv6Expand(ip_address)
    if ( v6ToBin_e == "" ) return ""
    v6ToBin_b = ""
    v6ToBin_n = split(v6ToBin_e, groups, ":")
    for (v6ToBin_i = 1; v6ToBin_i <= v6ToBin_n; v6ToBin_i++) {
        v6ToBin_v = cawk_hexToDec(groups[v6ToBin_i])
        if ( v6ToBin_v < 0 ) return ""
        v6ToBin_b = v6ToBin_b cawk_decToBin(int(v6ToBin_v / 256)) cawk_decToBin(v6ToBin_v % 256)
    }
    return v6ToBin_b
}

function cawk_binaryToIP(binary,    ip_address, octet, binaryToIP_i) {
    ip_address = ""
    for (binaryToIP_i = 1; binaryToIP_i <= length(binary); binaryToIP_i = binaryToIP_i + 8) {
        octet = substr(binary, binaryToIP_i, 8)
	ip_address = ip_address cawk_binToDec(octet);
        if (binaryToIP_i < length(binary) - 7) {
            ip_address = ip_address "."
        }
    }
    return ip_address
}

# bitwise AND of two bit strings of the same length (network address = ip AND netmask)
function cawk_binaryAND(binary1, binary2,    result, digit1, digit2, binaryAND_i) {
    result = ""
    for (binaryAND_i = 1; binaryAND_i <= length(binary1); binaryAND_i++) {
        digit1 = substr(binary1, binaryAND_i, 1)
        digit2 = substr(binary2, binaryAND_i, 1)
        if (digit1 == 1 && digit2 == 1) {
            result = result "1"
        } else {
            result = result "0"
        }
    }
    return result
}

# bitwise OR of two bit strings of the same length (broadcast address = network OR hostmask)
function cawk_binaryOR(binary1, binary2,    result, digit1, digit2, binaryOR_i) {
    result = ""
    for (binaryOR_i = 1; binaryOR_i <= length(binary1); binaryOR_i++) {
        digit1 = substr(binary1, binaryOR_i, 1)
        digit2 = substr(binary2, binaryOR_i, 1)
        if ((digit1 == 1 && digit2 == 0) || (digit1 == 0 && digit2 == 1)) {
            result = result "1"
        } else {
            result = result "0"
        }
    }
    return result
}

function cawk_binToDec(binary,    decimal, power, digit, binToDec_i) {
    decimal = 0
    power = length(binary) - 1
    for (binToDec_i = 1; binToDec_i <= length(binary); binToDec_i++) {
        digit = substr(binary, binToDec_i, 1)
        decimal += digit * 2^power
        power--
    }
    return decimal
}

function cawk_decToBin(decimal,    decToBin_b, decToBin_r) {
    decToBin_b = ""
    while (decimal > 0) {
        decToBin_r = decimal % 2
        decToBin_b = decToBin_r decToBin_b
        decimal = int(decimal / 2)
    }
    while (length(decToBin_b) < 8) {
        decToBin_b = "0" decToBin_b
    }
    return decToBin_b
}

function cawk_max(x, y) { return (x > y) ? x : y }
function cawk_min(x, y) { return (x < y) ? x : y }

# every address bound is a 129-bit 0/1 string: a family bit (0 ipv4, 1 ipv6) then 128 address
# bits (ipv4 left-padded with zeros by cawk_addr_range), so bounds compare with the plain string
# operators: they never come from input fields, hence are never gawk numeric strings, and
# doubles (53 bits) are not involved; the family bit keeps ipv4 ranges out of ::/96

