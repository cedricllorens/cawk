# CUBE ADD RULES
# -----------------------------------------------
# -----------------------------------------------

# compute the [first,last] binary range of an ip/net pair ; memoized as the combinatory of a term
# rebuilds the same pair for every port/protocol/icmp combination
# the bounds are 129-bit binary strings (family bit then 128 address bits), compared exactly
# as strings: gawk doubles only keep 53 bits, so hosts of a same ipv6 /64 would collide
# an address holding ":" is ipv6 and is expanded on 128 bits; an unparsable address, a prefix
# longer than the family, or a dotted netmask on an ipv6 address yields the empty bound "" so
# its rule is not assessed (like the other unmodelled selectors)
function cawk_addr_range(ip_address, cidr, range_out,    key, is_v6, total_bits, addr_bin, net_bin, fam, pad) {
	key = ip_address SUBSEP cidr
	if ( key in cawk_addr_cache ) {
		range_out[1] = cawk_addr_cache[key][1]
		range_out[2] = cawk_addr_cache[key][2]
		return
	}

	cawk_bits_init()
	is_v6 = ( ip_address ~ /:/ )
	total_bits = ( is_v6 ) ? 128 : 32
	fam = ( is_v6 ) ? "1" : "0"
	pad = ( is_v6 ) ? "" : substr(cawk_zeros128, 1, 96)

	range_out[1] = range_out[2] = ""
	if ( cidr == "any" ) {
		# any means any address of any family: from the first ipv4 to the last ipv6 address
		range_out[1] = "0" cawk_zeros128
		range_out[2] = "1" cawk_ones128
	} else if ( cidr ~ /^0+$/ ) {
		# a /0 ignores its address (cisco standard acls pass dst 0/0): the whole family
		range_out[1] = fam cawk_zeros128
		range_out[2] = fam pad substr(cawk_ones128, 1, total_bits)
	} else if ( cidr != "none" ) {
		addr_bin =( is_v6 ) ? cawk_ipv6ToBinary(ip_address) : cawk_ipToBinary(ip_address)
		if ( addr_bin == "" ) {
			# unparsable address: not assessed
		} else if ( cidr == "host" ) {
			range_out[1] = range_out[2] = fam pad addr_bin
		} else if ( cidr ~ /^[0-9]+$/ ) {
			if ( cidr + 0 <= total_bits ) {
				range_out[1] = fam pad substr(addr_bin, 1, cidr) substr(cawk_zeros128, 1, total_bits - cidr)
				range_out[2] = fam pad substr(addr_bin, 1, cidr) substr(cawk_ones128, 1, total_bits - cidr)
			}
		} else if ( !is_v6 && cawk_isDottedQuad(cidr) ) {
			net_bin = cawk_binaryAND(addr_bin, cawk_netMaskToBinary(cidr))
			range_out[1] = fam pad net_bin
			range_out[2] = fam pad cawk_binaryOR(cawk_hostMaskToBinary(cidr), net_bin)
		}
	}

	cawk_addr_cache[key][1] = range_out[1]
	cawk_addr_cache[key][2] = range_out[2]
}

# store one rule as a box of the cube: addresses are converted once to exact [first,last] bounds,
# so that the assessment only compares strings and integers
function cawk_add_hypercube_rules(rule_name,rule_description,action,inoutgress,interface,family,src,src_net,port_src,port_src_range,dst,dst_net,port_dst,port_dst_range,protocol,icmp_type,source_rule,rule_order,    addr_range) {

	# rule format ----------------------------------
	# 1  rule_name          : string
	# 2  rule_description   : string
	# 3  action             : permit/deny
	# 4  ingress/outgress   : "none","in","out","all"
	# 5  interface          : "none",string
	# 6  family             : "all", inet, inet6
	# 7  src@               : ip
	# 8  src_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
	# 9  port_src           : port_src			set 0 if empty
	# 10 port_src_range     : port_src_range	set 0 if empty
	# 11 dst@               : ip				set 0 if empty
	# 12 dst_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
	# 13 port_dst           : port_dst			set 0 if empty
	# 14 port_dst_range     : port_dst_range	set 0 if empty
	# 15 protocol           : protocol			set "none" if empty
	# 16 icmp_type          : "type" or "type/code"	optional, empty for any icmp message
	# 17 source_rule        : id of the configuration rule (line, term) this cube rule comes from, optional
	#                         several cube rules expanded from one configuration rule share it and are never compared together
	#                         default: the cube rule itself (every cube rule is its own source)
	# 18 rule_order         : evaluation rank of the source rule in its acl, optional (default: source_rule, then the
	#                         insertion order); the lowest rank is the upper rule (the one a packet meets first)
	# rule format ----------------------------------

	# the cube is stored in flat arrays : array of arrays lookups dominate the assessment cost ----
	cawk_current_rule += 1

	# trace ----
	if ( trace ==1 ) {
		print "TRACE RULE = rule_desc:"rule_description" action:"action" inout:"inoutgress" int:"interface" family:"family" src_ip:"src" src_net:"src_net" port_src:"port_src" port_src_range:" port_src_range" dst_ip:"dst" dst_net:"dst_net" port_dst:"port_dst" dst_port_range:"port_dst_range" proto:"protocol
	}

	c_name[cawk_current_rule] = rule_name
	c_desc[cawk_current_rule] = rule_description
	c_action[cawk_current_rule] = action
	c_io[cawk_current_rule] = inoutgress
	c_fam[cawk_current_rule] = family
	c_if[cawk_current_rule] = interface

	c_src_orig[cawk_current_rule] = src"/"src_net
	cawk_addr_range(src, src_net, addr_range)
	c_src0[cawk_current_rule] = addr_range[1]
	c_src1[cawk_current_rule] = addr_range[2]

	c_dst_orig[cawk_current_rule] = dst"/"dst_net
	cawk_addr_range(dst, dst_net, addr_range)
	c_dst0[cawk_current_rule] = addr_range[1]
	c_dst1[cawk_current_rule] = addr_range[2]

	c_ps[cawk_current_rule] = port_src
	c_psr[cawk_current_rule] = port_src_range
	c_pd[cawk_current_rule] = port_dst
	c_pdr[cawk_current_rule] = port_dst_range

	c_proto[cawk_current_rule] = protocol
	c_icmp[cawk_current_rule] = icmp_type

	c_source[cawk_current_rule] = ( source_rule == "" ) ? "cube_" cawk_current_rule : source_rule
	c_order[cawk_current_rule] = ( rule_order != "" ) ? rule_order + 0 : ( source_rule != "" ) ? source_rule + 0 : cawk_current_rule
}

# -----------------------------------------------
# -----------------------------------------------
# ICMP MESSAGES
# -----------------------------------------------
# -----------------------------------------------

# two icmp selectors ("", "type" or "type/code") overlap unless their types, or their codes, differ
function cawk_icmp_overlap(icmp1, icmp2,    icmp_a, icmp_b) {
	if ( icmp1 == "" || icmp2 == "" ) return 1
	split(icmp1, icmp_a, "/")
	split(icmp2, icmp_b, "/")
	if ( icmp_a[1] != icmp_b[1] ) return 0
	if ( icmp_a[2] == "" || icmp_b[2] == "" ) return 1
	return ( icmp_a[2] == icmp_b[2] )
}

function cawk_icmp_label(icmp_type) {
	return ( icmp_type == "" ) ? "" : " icmp-type "icmp_type
}

# -----------------------------------------------
# -----------------------------------------------
# CUBE RULES ASSESSMENT
# -----------------------------------------------
# -----------------------------------------------

# two port selectors (port, range end) intersect: range 0 is the single port, 0/0 is every port
function port_ranges_overlap(port1, range1, port2, range2,    end1, end2) {

    # 0 value case for range ----
    end1 = (range1 == 0) ? port1 : range1
    end2 = (range2 == 0) ? port2 : range2
    
    # 0/0 value case ----
    if (port1 == 0 && range1 == 0) return 1
    if (port2 == 0 && range2 == 0) return 1
    
    # check overlap ----
    return (port1 <= end2 && port2 <= end1)
}

# -----------------------------------------------

# b is contained in a on one port dimension (port, port_range): 0/0 is every port, a range 0 is the single port
function cawk_port_contains(pa, ra, pb, rb,    ea, eb) {
	if ( pa == 0 && ra == 0 ) return 1
	if ( pb == 0 && rb == 0 ) return 0
	ea = ( ra == 0 ) ? pa : ra
	eb = ( rb == 0 ) ? pb : rb
	return ( pa <= pb && eb <= ea )
}

# every packet matched by cube rule b is matched by cube rule a, on all the dimensions of the cube
function cawk_rule_contains(a, b,    ia) {
	if ( c_src0[a] > c_src0[b] || c_src1[b] > c_src1[a] ) return 0
	if ( c_dst0[a] > c_dst0[b] || c_dst1[b] > c_dst1[a] ) return 0
	if ( !( c_io[a] == "none" || c_io[a] == "all" || c_io[a] == c_io[b] ) ) return 0
	if ( !( c_if[a] == "none" || c_if[a] == c_if[b] ) ) return 0
	if ( !( c_fam[a] == "all" || c_fam[a] == c_fam[b] ) ) return 0
	if ( !( c_proto[a] == "none" || c_proto[a] == c_proto[b] ) ) return 0
	if ( c_icmp[a] != "" && c_icmp[a] != c_icmp[b] ) {
		# "type" contains "type/code"
		if ( c_icmp[a] ~ /\// || split(c_icmp[b], ia, "/") < 1 || ia[1] != c_icmp[a] ) return 0
	}
	if ( !cawk_port_contains(c_ps[a], c_psr[a], c_ps[b], c_psr[b]) ) return 0
	if ( !cawk_port_contains(c_pd[a], c_pdr[a], c_pd[b], c_pdr[b]) ) return 0
	return 1
}

# ALGORITHM of cawk_hypercube_rules_assessment() ----
# every rule of an acl is a box of the cube: address range of the source, of the destination,
# port ranges, protocol, icmp message, direction, interface and ip family. Two rules are compared
# when their boxes intersect on every dimension. The pair is then classified with the rule order,
# the upper rule being the one a packet meets first (rule_order, first match wins; cawk_order = "last"
# reverses it, cawk_order = "none" disables the classification and reports every intersection):
#   1. the lower box is inside the upper box, same action  -> redundant rules (the lower rule is useless)
#   2. the lower box is inside the upper box, other action -> inconsistent rules (the lower rule is shadowed: never reached)
#   3. the upper box is inside the lower box, other action -> not reported: a specific rule above a general
#      one (the final "deny any any") is the normal way to write an acl; cawk_show_generalization = 1 reports it
#   4. the upper box is inside the lower box, same action  -> redundant rules (the upper rule adds nothing)
#   5. partial overlap, same action                        -> redundant rules
#   6. partial overlap, other action                       -> inconsistent rules (the outcome depends on the rule order)
# cube rules expanded from one configuration rule (same source_rule) are never compared together.
# Cost: one pass over the pairs, the address bounds filter first, containment only on intersecting pairs.
#
# REPORT REDUCTION: the pairs are compared per cube, but the reader thinks per configuration rule, so the
# findings are accumulated during the pass and printed at the end of it, with the same line format:
#   a. cases 1, 2 and 4 (one rule is dead) are grouped by the dead rule ("victim") and by verdict: the
#      line shows the nearest partner in the rule order and "(+K other rules)" for the K other rules
#      that also cover it; the verdict and the dead rule are never hidden
#   b. the other cases (3 with cawk_show_generalization, 5, 6) are grouped by pair of configuration
#      rules and verdict: the cube pairs of the same two rules give one line, "(xN cubes)" when N > 1
# The set of (rule, verdict) found is the same as without the reduction, only the number of lines drops.

function cawk_hypercube_rules_assessment(    r, t, rs0, rs1, rd0, rd1, ra, rio, rif, rfam, rproto, ricmp, rps, rpsr, rpd, rpdr, rzero, rule_analysis, rsrc, up, lo, swap, victim, partner, partner_order, key, pkey, suffix, g, ng, g_ord, g_r, g_t, g_n, g_k, g_best, g_seen, tsrc, show_inconsistent, show_redundant) {

	# rule r is read once out of the inner loop, and the cheapest dimension (address) filters first ----
	res_hypercube_assessment = 1;
	ng = 0
	# options exported by gmake; defaults when the test runs without it ----
	show_inconsistent = ( ENVIRON["HYPERCUBE_INCONSISTENCY"] != "no" )
	show_redundant = ( ENVIRON["HYPERCUBE_REDUNDANCY"] != "no" )

	for ( r = 1; r < cawk_current_rule; r++ ) {

		# a rule with an unparsable address is not assessed ----
		if ( c_dst0[r] == "" ) continue

		rs0 = c_src0[r]; rs1 = c_src1[r]; rd0 = c_dst0[r]; rd1 = c_dst1[r]
		ra = c_action[r]; rio = c_io[r]; rif = c_if[r]; rfam = c_fam[r]; rproto = c_proto[r]; ricmp = c_icmp[r]
		rps = c_ps[r]; rpsr = c_psr[r]; rpd = c_pd[r]; rpdr = c_pdr[r]
		rzero = ( rps == 0 && rpsr == 0 && rpd == 0 && rpdr == 0 )
		rsrc = c_source[r]

		for ( t = r + 1; t <= cawk_current_rule; t++ ) {

			if ( c_src0[t] == "" ) continue

			# cube rules of one configuration rule are not compared together ----
			if ( c_source[t] == rsrc ) continue

			# inoutgress equal ----
			if ( !( rio == "none" || c_io[t] == "none" || rio == "all" || c_io[t] == "all" || rio == c_io[t] ) ) continue

			# interface equal ----
			if ( !( rif == c_if[t] || rif == "none" || c_if[t] == "none" ) ) continue

			# family equal ----
			if ( !( rfam == c_fam[t] || rfam == "all" || c_fam[t] == "all" ) ) continue

			# protocol equal ----
			if ( !( rproto == c_proto[t] || rproto == "none" || c_proto[t] == "none" ) ) continue
			# address intersection (exact binary bounds): disjoint when one starts after the other ends ----
			if ( rs0 > c_src1[t] || c_src0[t] > rs1 ) continue
			if ( rd0 > c_dst1[t] || c_dst0[t] > rd1 ) continue

			if ( !cawk_icmp_overlap(ricmp, c_icmp[t]) ) continue

			# port match ----
			if ( !( \
				( rps == c_ps[t] && rpsr == c_psr[t] && rpd == c_pd[t] && rpdr == c_pdr[t] ) || \
				rzero || \
				( c_ps[t] == 0 && c_psr[t] == 0 && c_pd[t] == 0 && c_pdr[t] == 0 ) || \
				( port_ranges_overlap(rps, rpsr, c_ps[t], c_psr[t]) && port_ranges_overlap(rpd, rpdr, c_pd[t], c_pdr[t]) ) \
			) ) continue

			# here all the dimensions have matched in order to find errors ----
			rule_analysis = ( ra == c_action[t] ) ? "redundant rules" : "inconsistent rules"
			if ( ra == c_action[t] ? !show_redundant : !show_inconsistent ) continue

			# victim: the dead rule of a containment pair, "" when the pair is a partial overlap or unordered ----
			victim = ""
			partner = ""

			# the position of the rules tells which one is upper (met first), then the containment tells the case ----
			if ( cawk_order != "none" ) {
				swap = ( cawk_order == "last" )
				if ( c_order[r] == c_order[t] ) { up = r; lo = t }
				else if ( ( c_order[r] < c_order[t] ) != swap ) { up = r; lo = t }
				else { up = t; lo = r }

				if ( cawk_rule_contains(up, lo) ) {
					# cases 1 and 2: the lower rule is dead ----
					victim = c_source[lo]; partner = c_source[up]; partner_order = c_order[up]
				} else if ( cawk_rule_contains(lo, up) ) {
					if ( ra != c_action[t] ) {
						# case 3: a specific rule above a general one is an exception, not an error ----
						if ( !cawk_show_generalization ) continue
					} else {
						# case 4: the upper rule adds nothing, it is the dead one ----
						victim = c_source[up]; partner = c_source[lo]; partner_order = c_order[lo]
					}
				}
			}
			res_hypercube_assessment = 0;

			# accumulate the finding instead of printing it ----
			if ( victim != "" ) {
				# group by dead rule and verdict ----
				key = "V" SUBSEP victim SUBSEP rule_analysis
				if ( !( key in g_n ) ) {
					g_ord[++ng] = key
					g_r[key] = r; g_t[key] = t; g_n[key] = 1; g_k[key] = 0
					g_best[key] = partner_order; g_seen[key SUBSEP partner] = 1; g_seen[key] = partner
				} else if ( !( ( key SUBSEP partner ) in g_seen ) ) {
					# a new partner rule: counted, and kept as the shown one when it is nearer in the rule order ----
					g_seen[key SUBSEP partner] = 1; g_k[key]++
					if ( partner_order < g_best[key] ) {
						g_r[key] = r; g_t[key] = t; g_n[key] = 1; g_best[key] = partner_order; g_seen[key] = partner
					}
				} else if ( g_seen[key] == partner ) {
					# one more cube pair of the shown rules ----
					g_n[key]++
				}
			} else {
				# group by pair of configuration rules (sorted, so that the cube order does not matter) and verdict ----
				tsrc = c_source[t]
				pkey = ( rsrc < tsrc ) ? rsrc SUBSEP tsrc : tsrc SUBSEP rsrc
				key = "P" SUBSEP pkey SUBSEP rule_analysis
				if ( !( key in g_n ) ) {
					g_ord[++ng] = key
					g_r[key] = r; g_t[key] = t; g_n[key] = 1; g_k[key] = 0
				} else g_n[key]++
			}
		}
	}

	# print the accumulated findings, in the order they were met ----
	for ( g = 1; g <= ng; g++ ) {
		key = g_ord[g]
		r = g_r[key]; t = g_t[key]
		rule_analysis = ( c_action[r] == c_action[t] ) ? "redundant rules" : "inconsistent rules"
		suffix = ""
		if ( g_k[key] > 0 ) suffix = " (+" g_k[key] " other rules)"
		else if ( g_n[key] > 1 ) suffix = " (x" g_n[key] " cubes)"
		print_err(\
		c_name[r],\
		" == "c_desc[r]" == action("c_action[r]") inoutgress("c_io[r]") int("c_if[r]") family("c_fam[r]") "\
		"src("c_src_orig[r]") src_port("c_ps[r]"/"c_psr[r]") "\
		"dst("c_dst_orig[r]") dst_port("c_pd[r]"/"c_pdr[r]") "\
		"protocol("c_proto[r] cawk_icmp_label(c_icmp[r])\
		") == "c_desc[t]" == action("c_action[t]") inoutgress("c_io[t]") int("c_if[t]") family("c_fam[t]") "\
		"src("c_src_orig[t]") src_port("c_ps[t]"/"c_psr[t]") "\
		"dst("c_dst_orig[t]") dst_port("c_pd[t]"/"c_pdr[t]") "\
		"protocol("c_proto[t] cawk_icmp_label(c_icmp[t])\
		") == "rule_analysis suffix,FNR,"info","warning");
	}

	return res_hypercube_assessment;
}
