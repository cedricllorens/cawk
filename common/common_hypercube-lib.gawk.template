# compute the [first,last] integer range of an ip/net pair ; memoized as the combinatory of a term
# rebuilds the same pair for every port/protocol/icmp combination
function cawk_addr_range(ip_address, cidr, range_out,    key) {
	key = ip_address SUBSEP cidr
	if ( key in cawk_addr_cache ) {
		range_out[1] = cawk_addr_cache[key][1]
		range_out[2] = cawk_addr_cache[key][2]
		return
	}

	if ( cidr == "none" ) {
		range_out[1] = -1
		range_out[2] = -1
	} else if ( cidr == "host" ) {
		range_out[1] = range_out[2] = cawk_binToDec(cawk_ipToBinary(ip_address))
	} else if ( cidr == "any" ) {
		range_out[1] = cawk_binToDec(cawk_ipToBinary("0.0.0.0"))
		range_out[2] = cawk_binToDec(cawk_ipToBinary("255.255.255.255"))
	} else if ( cidr ~ /^[0-9]+$/ ) {
		range_out[1] = cawk_binToDec(cawk_binaryAND(cawk_ipToBinary(ip_address),cawk_cidrNetworkMask(cidr)))
		range_out[2] = cawk_binToDec(cawk_binaryOR(cawk_cidrHostMask(cidr),cawk_binaryAND(cawk_ipToBinary(ip_address),cawk_cidrNetworkMask(cidr))))
	} else {
		range_out[1] = cawk_binToDec(cawk_binaryAND(cawk_ipToBinary(ip_address),cawk_netMaskToBinary(cidr)))
		range_out[2] = cawk_binToDec(cawk_binaryOR(cawk_hostMaskToBinary(cidr),cawk_binaryAND(cawk_ipToBinary(ip_address),cawk_netMaskToBinary(cidr))))
	}

	cawk_addr_cache[key][1] = range_out[1]
	cawk_addr_cache[key][2] = range_out[2]
}

function cawk_add_hypercube_rules(rule_name,rule_description,action,inoutgress,interface,family,src,src_net,port_src,port_src_range,dst,dst_net,port_dst,port_dst_range,protocol,icmp_type,    addr_range) {

	# rule format ----------------------------------
	# 1  rule_name          : string
	# 2  rule_description   : string
	# 3  action             : permit/deny
	# 4  ingress/outgress   : "none","in","out","all"
	# 5  interface          : "none",string
	# 6  family             : "all", inet, inet6
	# 7  src@               : ip
	# 8  src_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
	# 9  port_src           : port_src			set 0 if empty
	# 10 port_src_range     : port_src_range	set 0 if empty
	# 11 dst@               : ip				set 0 if empty
	# 12 dst_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
	# 13 port_dst           : port_dst			set 0 if empty
	# 14 port_dst_range     : port_dst_range	set 0 if empty
	# 15 protocol           : protocol			set "none" if empty
	# 16 icmp_type          : "type" or "type/code"	optional, empty for any icmp message
	# rule format ----------------------------------

	# the cube is stored in flat arrays : array of arrays lookups dominate the assessment cost ----
	cawk_current_rule += 1

	# trace ----
	if ( trace ==1 ) {
		print "TRACE RULE = rule_desc:"rule_description" action:"action" inout:"inoutgress" int:"interface" family:"family" src_ip:"src" src_net:"src_net" port_src:"port_src" port_src_range:" port_src_range" dst_ip:"dst" dst_net:"dst_net" port_dst:"port_dst" dst_port_range:"port_dst_range" proto:"protocol
	}

	c_name[cawk_current_rule] = rule_name
	c_desc[cawk_current_rule] = rule_description
	c_action[cawk_current_rule] = action
	c_io[cawk_current_rule] = inoutgress
	c_fam[cawk_current_rule] = family
	c_if[cawk_current_rule] = interface

	c_src_orig[cawk_current_rule] = src"/"src_net
	cawk_addr_range(src, src_net, addr_range)
	c_src0[cawk_current_rule] = addr_range[1]
	c_src1[cawk_current_rule] = addr_range[2]

	c_dst_orig[cawk_current_rule] = dst"/"dst_net
	cawk_addr_range(dst, dst_net, addr_range)
	c_dst0[cawk_current_rule] = addr_range[1]
	c_dst1[cawk_current_rule] = addr_range[2]

	c_ps[cawk_current_rule] = port_src
	c_psr[cawk_current_rule] = port_src_range
	c_pd[cawk_current_rule] = port_dst
	c_pdr[cawk_current_rule] = port_dst_range

	c_proto[cawk_current_rule] = protocol
	c_icmp[cawk_current_rule] = icmp_type
}

# -----------------------------------------------
# -----------------------------------------------
# ICMP MESSAGES
# -----------------------------------------------
# -----------------------------------------------

# two icmp selectors ("", "type" or "type/code") overlap unless their types, or their codes, differ
function cawk_icmp_overlap(icmp1, icmp2,    icmp_a, icmp_b) {
	if ( icmp1 == "" || icmp2 == "" ) return 1
	split(icmp1, icmp_a, "/")
	split(icmp2, icmp_b, "/")
	if ( icmp_a[1] != icmp_b[1] ) return 0
	if ( icmp_a[2] == "" || icmp_b[2] == "" ) return 1
	return ( icmp_a[2] == icmp_b[2] )
}

function cawk_icmp_label(icmp_type) {
	return ( icmp_type == "" ) ? "" : " icmp-type "icmp_type
}

# -----------------------------------------------
# -----------------------------------------------
# CUBE RULES ASSESSMENT
# -----------------------------------------------
# -----------------------------------------------

function port_ranges_overlap(port1, range1, port2, range2) {

    # 0 value case for range ----
    end1 = (range1 == 0) ? port1 : range1
    end2 = (range2 == 0) ? port2 : range2
    
    # 0/0 value case ----
    if (port1 == 0 && range1 == 0) return 1
    if (port2 == 0 && range2 == 0) return 1
    
    # check overlap ----
    return (port1 <= end2 && port2 <= end1)
}

# -----------------------------------------------

function cawk_hypercube_rules_assessment(    r, t, rs0, rs1, rd0, rd1, ra, rio, rif, rfam, rproto, ricmp, rps, rpsr, rpd, rpdr, rzero, x1, x2, y1, y2, rule_analysis) {

	# rule r is read once out of the inner loop, and the cheapest dimension (address) filters first ----
	res_hypercube_assessment = 1;

	for ( r = 1; r < cawk_current_rule; r++ ) {

		if ( c_dst0[r] < 0 ) continue

		rs0 = c_src0[r]; rs1 = c_src1[r]; rd0 = c_dst0[r]; rd1 = c_dst1[r]
		ra = c_action[r]; rio = c_io[r]; rif = c_if[r]; rfam = c_fam[r]; rproto = c_proto[r]; ricmp = c_icmp[r]
		rps = c_ps[r]; rpsr = c_psr[r]; rpd = c_pd[r]; rpdr = c_pdr[r]
		rzero = ( rps == 0 && rpsr == 0 && rpd == 0 && rpdr == 0 )

		for ( t = r + 1; t <= cawk_current_rule; t++ ) {

			if ( c_src0[t] < 0 ) continue

			# address intersection ----
			x1 = ( rs0 > c_src0[t] ) ? rs0 : c_src0[t]
			x2 = ( rs1 < c_src1[t] ) ? rs1 : c_src1[t]
			if ( x1 > x2 ) continue
			y1 = ( rd0 > c_dst0[t] ) ? rd0 : c_dst0[t]
			y2 = ( rd1 < c_dst1[t] ) ? rd1 : c_dst1[t]
			if ( y1 > y2 ) continue

			# inoutgress equal ----
			if ( !( rio == "none" || c_io[t] == "none" || rio == "all" || c_io[t] == "all" || rio == c_io[t] ) ) continue

			# interface equal ----
			if ( !( rif == c_if[t] || rif == "none" || c_if[t] == "none" ) ) continue

			# family equal ----
			if ( !( rfam == c_fam[t] || rfam == "all" || c_fam[t] == "all" ) ) continue

			# protocol equal ----
			if ( !( rproto == c_proto[t] || rproto == "none" || c_proto[t] == "none" ) ) continue
			if ( !cawk_icmp_overlap(ricmp, c_icmp[t]) ) continue

			# port match ----
			if ( !( \
				( rps == c_ps[t] && rpsr == c_psr[t] && rpd == c_pd[t] && rpdr == c_pdr[t] ) || \
				rzero || \
				( c_ps[t] == 0 && c_psr[t] == 0 && c_pd[t] == 0 && c_pdr[t] == 0 ) || \
				( port_ranges_overlap(rps, rpsr, c_ps[t], c_psr[t]) && port_ranges_overlap(rpd, rpdr, c_pd[t], c_pdr[t]) ) \
			) ) continue

			# here all the dimensions have matched in order to find errors ----
			rule_analysis = ( ra == c_action[t] ) ? "redundant rules" : "inconsistent rules"
			res_hypercube_assessment = 0;
			print_err(\
			c_name[r],\
			" == "c_desc[r]" == action("ra") inoutgress("rio") int("rif") family("rfam") "\
			"src("c_src_orig[r]") src_port("rps"/"rpsr") "\
			"dst("c_dst_orig[r]") dst_port("rpd"/"rpdr") "\
			"protocol("rproto cawk_icmp_label(ricmp)\
			") == "c_desc[t]" == action("c_action[t]") inoutgress("c_io[t]") int("c_if[t]") family("c_fam[t]") "\
			"src("c_src_orig[t]") src_port("c_ps[t]"/"c_psr[t]") "\
			"dst("c_dst_orig[t]") dst_port("c_pd[t]"/"c_pdr[t]") "\
			"protocol("c_proto[t] cawk_icmp_label(c_icmp[t])\
			") == "rule_analysis,FNR,"info","error");
		}
	}

	return res_hypercube_assessment;
}
