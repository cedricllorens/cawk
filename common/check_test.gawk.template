# -----------------------------------------------------------------------
# This script checks that a cawk test code is compliant with
# internal coding rules
#  in case of error, start print message with cawk test error: and to end with NOK
#  in case of success, start print message with cawk test pass : and to end with OK
# -----------------------------------------------------------------------

# splits the arguments of a call: s[i] is the char following the opening "("
# fills args[1..n] (trimmed) and returns n; quotes and nested parentheses are
# skipped so that commas inside strings or sub-expressions do not split
function split_call_args(s, i, args,    n, depth, instr, c, cur, len) {
    delete args
    n = 0
    depth = 1
    instr = 0
    cur = ""
    len = length(s)
    for (; i <= len; i++) {
        c = substr(s, i, 1)
        if (instr) {
            cur = cur c
            if (c == "\\") {
                i++
                cur = cur substr(s, i, 1)
            } else if (c == "\"") {
                instr = 0
            }
            continue
        }
        if (c == "\"") {
            instr = 1
        } else if (c == "(") {
            depth++
        } else if (c == ")") {
            depth--
            if (depth == 0) break
        } else if (c == "," && depth == 1) {
            args[++n] = cur
            cur = ""
            continue
        }
        cur = cur c
    }
    args[++n] = cur
    for (i = 1; i <= n; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", args[i])
    }
    return n
}

function literal_value(arg) {
    return substr(arg, 2, length(arg) - 2)
}

function is_literal(arg) {
    return arg ~ /^"([^"\\]|\\.)*"$/
}

function fail(msg) {
    print "cawk test error: " msg " NOK"
    error_count++
}

BEGINFILE {
    # extract just the file name (without path) and its directory
    n = split(FILENAME, parts, "/")
    filename = parts[n]
    dirname = (n > 1) ? parts[n - 1] : ""

    # <test>.<supplier>.gawk -> supplier
    n = split(filename, name_parts, ".")
    file_supplier = (n >= 3) ? name_parts[n - 1] : ""

    error_count = 0
    in_beginfile_block = 0
    has_endfile = 0
    code = ""
    code_lines = 0
    tag_test_name = ""
    tag_supplier = ""

    delete kept_fnr
    delete arrays_in_beginfile
    delete arrays_deleted_in_beginfile
}

# metadata tags live in comments: read them before comments are skipped
/^#[[:space:]]*@test_name[[:space:]]*:/ {
    tag_test_name = $0
    sub(/^#[[:space:]]*@test_name[[:space:]]*:[[:space:]]*/, "", tag_test_name)
    sub(/[[:space:]]+$/, "", tag_test_name)
}

/^#[[:space:]]*@supplier[[:space:]]*:/ {
    tag_supplier = $0
    sub(/^#[[:space:]]*@supplier[[:space:]]*:[[:space:]]*/, "", tag_supplier)
    sub(/[[:space:]]+$/, "", tag_supplier)
}

{
    # skip empty lines and comments
    if ($0 ~ /^[[:space:]]*$/ || $0 ~ /^[[:space:]]*#/) {
        next
    }

    # keep the code (multi-line print_err calls are checked in ENDFILE)
    code = code $0 "\n"
    kept_fnr[++code_lines] = FNR

    if ($0 ~ /^[[:space:]]*ENDFILE[[:space:]]*\{/) {
        has_endfile = 1
    }

    # track if we are in BEGINFILE block
    if (match($0, /^[[:space:]]*BEGINFILE\s*{/)) {
        in_beginfile_block = 1
        next
    }
    if (in_beginfile_block && match($0, /^[[:space:]]*}/)) {
        in_beginfile_block = 0
        next
    }

    # ========== MAIN VALIDATION RULES ==========

    # detect if a debug trace has been left in the code (case-insensitive)
    # string contents (messages) are ignored: they may legitimately say "debug"
    stripped = $0
    gsub(/"([^"\\]|\\.)*"/, "\"\"", stripped)
    if (match(tolower(stripped), /debug/) && !match(stripped, /case\s+/)) {
        fail("debug trace has been found " $0 " (in " FILENAME " line " FNR ")")
    }

    # detect comparison instead of assignation (== instead of =)
    # pattern: word == digit; (standalone statement)
    if (match($0, /^\s*(\w+)\s*==\s*[0-9];\s*$/, m)) {
        fail("comparison instead of assignation: " $0 " (in " FILENAME " line " FNR ")")
    }

    # detect typos in variable names (eexception_*, ppass_*, etc.)
    if (match($0, /(eexception|ppass|eextra|aarray|bblock|pprint|nnext|ddelete)/, m)) {
        fail("typo in variable name: " $0 " (in " FILENAME " line " FNR ")")
    }

    # detect regex pattern without block (pattern { missing)
    # pattern: /^regex$/ && /^regex$/ without following {
    if (match($0, /\/\^[^\/]+\/\$\s*&&\s*\/\^[^\/]+\/\$\s*[^{]*$/, m)) {
        fail("regex pattern without block { : " $0 " (in " FILENAME " line " FNR ")")
    }

    # track arrays used in BEGINFILE: they must be deleted there
    if (in_beginfile_block) {
        if (match($0, /\b([a-zA-Z_]\w*)\[/, m)) {
            arrays_in_beginfile[m[1]] = 1
        }
        if (match($0, /delete\s+([a-zA-Z_]\w*)/, m)) {
            arrays_deleted_in_beginfile[m[1]] = 1
        }
    }
}

ENDFILE {
    # arrays used in BEGINFILE must be deleted there (state is reset per conf file)
    for (array_name in arrays_in_beginfile) {
        # skip known internal arrays
        if (array_name ~ /^(parts|args_array|sig_parts|other_parts|m)$/) {
            continue
        }
        if (!(array_name in arrays_deleted_in_beginfile)) {
            fail("array '" array_name "' is used but not deleted (in " FILENAME ")")
        }
    }

    # an empty test can never emit a verdict
    if (!has_endfile) {
        fail("no ENDFILE block: the test cannot report a pass (in " FILENAME ")")
    }

    # names must agree with the file: metadata tags and directory
    if (tag_test_name != "" && tag_test_name != filename) {
        fail("@test_name=" tag_test_name " does not match file=" filename " (in " FILENAME ")")
    }
    if (tag_supplier != "" && tag_supplier != file_supplier) {
        fail("@supplier=" tag_supplier " does not match file supplier=" file_supplier " (in " FILENAME ")")
    }
    if (dirname ~ /^tests\./) {
        dir_supplier = dirname
        sub(/^tests\./, "", dir_supplier)
        sub(/\.psirt$/, "", dir_supplier)
        if (file_supplier != dir_supplier) {
            fail("file supplier=" file_supplier " does not match directory=" dirname " (in " FILENAME ")")
        }
    }

    # every print_err() call: 5 arguments, literal test name equal to the file,
    # valid risk_level and status_code (only quoted string literals are checked)
    call_count = 0
    rest = code
    offset = 0
    while (match(rest, /print_err[[:space:]]*\(/)) {
        call_count++
        start = offset + RSTART
        prefix = substr(code, 1, start)
        line_idx = gsub(/\n/, "\n", prefix) + 1
        where = "(in " FILENAME " line " kept_fnr[line_idx] ")"
        nargs = split_call_args(code, start + RLENGTH, args)

        if (nargs != 5) {
            fail("print_err called with " nargs " arguments (expected 5) " where)
        } else {
            if (!is_literal(args[1])) {
                fail("print_err test name is not a literal string: " args[1] " " where)
            } else if (literal_value(args[1]) != filename) {
                fail("file=" filename " print_err=" literal_value(args[1]) " " where)
            }
            if (is_literal(args[4]) && literal_value(args[4]) !~ /^(high|medium|low|info)$/) {
                fail("invalid risk_level=\"" literal_value(args[4]) "\" in print_err call (must be one of: high, medium, low, info) " where)
            }
            if (is_literal(args[5]) && literal_value(args[5]) !~ /^(pass|error|warning|psirt)$/) {
                fail("invalid status_code=\"" literal_value(args[5]) "\" in print_err call (must be one of: pass, error, warning, psirt) " where)
            }
        }

        offset = start + RLENGTH - 1
        rest = substr(code, offset + 1)
    }
    if (call_count == 0) {
        fail("no print_err() call: the test cannot report anything (in " FILENAME ")")
    }

    # Final report - only show pass message if no errors
    if (error_count == 0) {
        print "cawk test pass : " FILENAME " OK"
    }
}
