#%SED_GAWK_PATH%

# ------------------------------------------------------------
# cawk is subject to a MIT open-source licence
# please refer to the MIT licence file for further information
#
# it censors the sensitive parts of configurations (and of any text holding them : an assessment result
# line holds the configuration line it is about, so the reports and the logs do too) :
#   mode censor (default) : every file given as argument is copied, censored, into the directory
#                           CENSOR_OUT_DIR with the same name, or into the single file CENSOR_OUT_FILE
#   mode check            : nothing is written, the exit status is 1 when a line would still be censored
#                           (a secret the regexes know is still there), 0 when the file is clean
#   mode censor + CENSOR_CSV=yes : the files are cawk csv reports (conf;test;error_line;line_nb;risk;status), only the
#                           error_line (the fields 3 to NF-3, it may hold ';') is censored, the other columns are kept ;
#                           X.csv is written into X.censored.csv beside it
#
# usage: CENSOR_OUT_DIR=<dir> censor.gawk <file> [<file> ...]
#        CENSOR_OUT_FILE=<file> censor.gawk <file>
#        CENSOR_MODE=check censor.gawk <file> [<file> ...]
#
# the rules are the gawk code generated by the macros of m4/cawk_censor.m4 (database/censor/censor_regex.m4 -> database/censor/censor_regex) :
# censor_apply() applies every rule in order on a line (the rules of level external only when CENSOR_LEVEL is external) :
# the text matched by the group 1 of a regex is kept, the rest of the match is replaced by the word of the rule
# (the regexes are regex constants : a dynamic regex is recompiled at every line once more than 6 are in use)
#
# environment (so that nothing is altered by the shell or by awk) :
#   CENSOR_OUT_DIR           output directory of the mode censor without CENSOR_OUT_FILE (mandatory, must exist)
#   CENSOR_OUT_FILE          output file of the mode censor (optional, exactly one input file, its directory must exist)
#   CENSOR_MODE              censor (default) or check
#   CENSOR_CSV               yes: csv report mode described above (no CENSOR_OUT_DIR/CENSOR_OUT_FILE), no by default
#   CENSOR_LEVEL             internal (default) or external : external also applies the rules of level external
# ------------------------------------------------------------

@include %SED_CENSOR_REGEX_PATH%

function die(msg) {
	print "cawk error: censor: " msg > "/dev/stderr"
	exit 1
}

# quote a string for a single-quoted shell argument
function shell_quote(str,   n, parts, out, i) {
	n = split(str, parts, "'")
	out = "'" parts[1]
	for (i = 2; i <= n; i++) out = out "'\\''" parts[i]
	return out "'"
}

BEGIN {
	mode = ENVIRON["CENSOR_MODE"]
	if (mode == "") mode = "censor"
	if (mode != "censor" && mode != "check") die("CENSOR_MODE must be censor or check, not <" mode ">")

	out_file_env = ENVIRON["CENSOR_OUT_FILE"]
	out_dir = ENVIRON["CENSOR_OUT_DIR"]
	csv = (ENVIRON["CENSOR_CSV"] == "yes")
	if (csv && mode != "censor") die("CENSOR_CSV=yes needs CENSOR_MODE=censor")
	if (csv) FS = ";"

	if (mode == "censor" && !csv) {
		if (out_file_env != "") {
			if (ARGC > 2) die("CENSOR_OUT_FILE accepts exactly one input file")
			out_dir = out_file_env
			if (sub(/\/[^\/]*$/, "", out_dir)) { if (out_dir == "") out_dir = "/" } else out_dir = "."
			if (system("test -d " shell_quote(out_dir)) != 0) die("directory " out_dir " of the output file does not exist")
		} else {
			if (out_dir == "") die("CENSOR_OUT_DIR is not set")
			if (system("test -d " shell_quote(out_dir)) != 0) die("output directory " out_dir " does not exist")
		}
	}

	level_wanted = ENVIRON["CENSOR_LEVEL"]
	if (level_wanted == "") level_wanted = "internal"
	if (level_wanted != "internal" && level_wanted != "external") die("CENSOR_LEVEL must be internal or external, not <" level_wanted ">")
	external = (level_wanted == "external")
	censor_check()
}

BEGINFILE {
	if (mode == "censor") {
		if (csv) {
			out_file = FILENAME
			if (!sub(/\.csv$/, ".censored.csv", out_file)) die(FILENAME " is not a csv file")
		} else if (out_file_env == "") {
			out_file = FILENAME
			sub(/^.*\//, "", out_file)
			out_file = out_dir "/" out_file
		} else {
			out_file = out_file_env
		}
		# the output file is truncated here : censoring a file into itself would destroy it
		if (out_file == FILENAME) die("the output file is the input file")
		printf "" > out_file
	}
}

{
	line = $0
	# keep a Windows end of line out of the censored part
	carriage_return = ""
	if (sub(/\r$/, "", line)) carriage_return = "\r"

	if (csv) $0 = line
	if (csv && NF >= 6) {
		# the line is rebuilt from the fields: conf;test;<error_line>;line_nb;risk;status
		error_line = $3
		for (i = 4; i <= NF - 3; i++) error_line = error_line ";" $i
		censored = $1 ";" $2 ";" censor_apply(error_line, external) ";" $(NF - 2) ";" $(NF - 1) ";" $NF
	} else {
		censored = censor_apply(line, external)
	}

	if (mode == "check") {
		# a censored file is a fixed point of censor_apply() : a line still changed holds a secret
		if (censored != line) {
			print "cawk censor_check: " FILENAME ":" FNR ": " line > "/dev/stderr"
			found = 1
		}
	} else {
		# RT keeps the original end of line : a last line without newline stays without newline
		printf "%s%s", censored carriage_return, RT > out_file
	}
}

ENDFILE {
	if (mode == "censor") close(out_file)
}

END {
	if (mode == "check" && found) exit 1
}
