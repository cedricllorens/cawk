#%SED_GAWK_PATH%

# ==============================================================================
# PSIRT VULNERABILITY ASSESSMENT TOOL
# ============================================================================== 
# DESCRIPTION:
#   Generic pattern-based vulnerability detection tool with configurable logic
#   Automatically detects OS device information from inventory file
#   Supports line patterns, block patterns, and complex boolean logic
#
# REQUIREMENTS:
#   - Inventory file database/psirt_scopes/psirt_CAWK_PSIRT_OS_inventory_scope.txt
#     with format: "device_filename os_version chassis cpu"
#
# USER CONFIGURATION:
#   - Modify ONLY the section between "USER START" and "USER END"
#   - Define OS patterns, line patterns, block patterns, and logic
#
# SYNTAX REFERENCE:
#   LINE[1] == 1          -> line pattern 1 found
#   BLOCK[1] == 1         -> block 1 exists (start + end found)
#   BLOCK_LINE[1][1] == 1 -> line 1 of block 1 found
#   BLOCK_LINE[1][2] == 0 -> line 2 of block 1 NOT found
#
# VERSION: 1.0
# ==============================================================================

@include %SED_INCLUDE_PATH%
@include "CAWK_PSIRT_NAME"

# --------------------------------------

function eval_binary_logic(logic_expression,   expr, i, j, pattern_ref, line_pattern_ref, cmd, result) {
    # Create a copy of the expression to work with
    expr = logic_expression
    
    # Replace all array references with their actual values
    for (i = 1; i <= config_psirt_line_patterns_count; i++) {
        pattern_ref = "config_psirt_line_patterns_matched\\[" i "\\]"
        gsub(pattern_ref, config_psirt_line_patterns_matched[i], expr)
    }
    
    for (i = 1; i <= config_psirt_block_patterns_count; i++) {
        # Replace with block existence
        pattern_ref = "config_psirt_block_exists\\[" i "\\]"
        gsub(pattern_ref, config_psirt_block_exists[i], expr)
        
        # Replace individual line references using the new array structure
        for (j = 1; j <= config_psirt_block_patterns[i]["lines_count"]; j++) {
            line_pattern_ref = "config_psirt_block_patterns_lines_matched\\[" i "\\]\\[" j "\\]"
            gsub(line_pattern_ref, config_psirt_block_patterns_lines_matched[i][j], expr)
        }
    }
    
    # the substituted expression is made of 0/1 only : evaluate each distinct one once
    if (expr in logic_cache) return logic_cache[expr]

    # Now evaluate the expression directly using awk's evaluation
    cmd = "echo 'BEGIN { print (" expr ") }' | awk -f -"
    cmd | getline result
    close(cmd)
    logic_cache[expr] = result
    return result
}

# --------------------------------------

# quote a string for a single-quoted shell argument
function shell_quote(str,   n, parts, out, i) {
    n = split(str, parts, "'")
    out = "'" parts[1]
    for (i = 2; i <= n; i++) out = out "'\\''" parts[i]
    return out "'"
}

# splits a version into its numeric and alphabetic components : "15.4(3)T1" -> 15 4 3 T 1, "21.4R3-S5" -> 21 4 R 3 S 5
function version_split(v, comp,   n, rest) {
    n = 0
    rest = v
    while (match(rest, /[0-9]+|[A-Za-z]+/)) {
        comp[++n] = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
    }
    return n
}

# compares two versions component by component : -1, 0 or 1
# a missing component is 0 against a number and "" against letters, so 15.4(3) < 15.4(3)T < 15.4(3)T1
# a digit sorts before a letter ; the train letters (T, M, SE) are compared alphabetically,
# so across two trains bound the range with the same train letters
function version_cmp(a, b,   ca, cb, na, nb, i, x, y, x_num, y_num) {
    na = version_split(a, ca)
    nb = version_split(b, cb)
    for (i = 1; i <= na || i <= nb; i++) {
        x = (i in ca) ? ca[i] : ""
        y = (i in cb) ? cb[i] : ""
        x_num = (x ~ /^[0-9]+$/)
        y_num = (y ~ /^[0-9]+$/)
        if (x == "" && y_num) x = 0
        if (y == "" && x_num) y = 0
        if (x ~ /^[0-9]+$/ && y ~ /^[0-9]+$/) {
            if (x + 0 < y + 0) return -1
            if (x + 0 > y + 0) return 1
        } else {
            if ("" x < "" y) return -1
            if ("" x > "" y) return 1
        }
    }
    return 0
}

# true when the version and the platform ("chassis cpu") satisfy the OS_CMP[n] rule
function os_cmp_match(version, platform, n,   c) {
    if (version !~ /[0-9]/) return 0
    if (("platform" in OS_CMP[n]) && platform !~ OS_CMP[n]["platform"]) return 0
    c = version_cmp(version, OS_CMP[n]["min"])
    if (OS_CMP[n]["op"] == "eq") return (c == 0)
    if (OS_CMP[n]["op"] == "lt") return (c < 0)
    if (OS_CMP[n]["op"] == "le") return (c <= 0)
    if (OS_CMP[n]["op"] == "gt") return (c > 0)
    if (OS_CMP[n]["op"] == "ge") return (c >= 0)
    return (c >= 0 && version_cmp(version, OS_CMP[n]["max"]) <= 0)
}

# returns an error message when the user section cannot be used, "" otherwise
function check_psirt_config(   i, j, n, max, rest, ref, p, probe, cmd, result, regex_list, regex_count, last_ok) {
    # indexes must be contiguous from 1 : the matched flags are stored by position
    for (i in LINE) { n++; if (i + 0 > max) max = i + 0 }
    if (n != max) return "LINE indexes must be contiguous from 1"
    n = 0; max = 0
    for (i in BLOCK) { n++; if (i + 0 > max) max = i + 0 }
    if (n != max) return "BLOCK indexes must be contiguous from 1"
    for (i in BLOCK) {
        n = 0; max = 0
        for (j in BLOCK[i]["match"]) { n++; if (j + 0 > max) max = j + 0 }
        if (n != max) return "BLOCK[" i "][\"match\"] indexes must be contiguous from 1"
    }

    # OS_CMP : contiguous indexes, known operator, versions that can be compared
    n = 0; max = 0
    for (i in OS_CMP) { n++; if (i + 0 > max) max = i + 0 }
    if (n != max) return "OS_CMP indexes must be contiguous from 1"
    for (i in OS_CMP) {
        if (OS_CMP[i]["op"] !~ /^(eq|lt|le|gt|ge|between)$/) return "OS_CMP[" i "] has an unknown operator"
        if (OS_CMP[i]["min"] !~ /[0-9]/) return "OS_CMP[" i "] has no version"
        if (OS_CMP[i]["op"] == "between") {
            if (OS_CMP[i]["max"] !~ /[0-9]/) return "OS_CMP[" i "] has no maximum version"
            if (version_cmp(OS_CMP[i]["min"], OS_CMP[i]["max"]) > 0) return "OS_CMP[" i "] minimum version is greater than the maximum"
        }
    }

    # every reference of LOGIC must be declared
    rest = LOGIC
    while (match(rest, /BLOCK_LINE\[[0-9]+\]\[[0-9]+\]|BLOCK\[[0-9]+\]|LINE\[[0-9]+\]/)) {
        ref = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
        split(ref, p, /[^0-9]+/)
        if (ref ~ /^LINE/ && !(p[2] in LINE)) return "LOGIC uses undeclared " ref
        if (ref ~ /^BLOCK\[/ && !(p[2] in BLOCK)) return "LOGIC uses undeclared " ref
        if (ref ~ /^BLOCK_LINE/ && (!(p[2] in BLOCK) || !(p[3] in BLOCK[p[2]]["match"]))) return "LOGIC uses undeclared " ref
    }

    # what is left once references are replaced must be a valid expression
    probe = LOGIC
    gsub(/BLOCK_LINE\[[0-9]+\]\[[0-9]+\]|BLOCK\[[0-9]+\]|LINE\[[0-9]+\]/, "0", probe)
    if (probe ~ /[A-Za-z_]/) return "LOGIC contains an unknown identifier"
    cmd = "echo 'BEGIN { print (" probe ") }' | awk -f - 2>/dev/null"
    cmd | getline result
    close(cmd)
    if (result == "") return "LOGIC is not a valid expression"

    # an invalid regular expression is fatal for gawk and would stop the whole run :
    # every pattern is tested once in a child process
    regex_list = shell_quote(DEVICE)
    for (i in OS) regex_list = regex_list " " shell_quote(OS[i])
    for (i in OS_CMP) if ("platform" in OS_CMP[i]) regex_list = regex_list " " shell_quote(OS_CMP[i]["platform"])
    for (i in LINE) regex_list = regex_list " " shell_quote(LINE[i])
    for (i in BLOCK) {
        regex_list = regex_list " " shell_quote(BLOCK[i]["start"]) " " shell_quote(BLOCK[i]["end"])
        for (j in BLOCK[i]["match"]) regex_list = regex_list " " shell_quote(BLOCK[i]["match"][j])
    }
    regex_count = 0
    cmd = "printf '%s\\n' " regex_list " | gawk '{ print NR; fflush(); \"\" ~ $0 }' 2>/dev/null"
    while ((cmd | getline last_ok) > 0) regex_count++
    if (close(cmd) != 0) return "invalid regular expression in the psirt configuration (pattern number " regex_count ")"
    return ""
}

# loaded on first use : a test whose DEVICE matches no configuration never reads the inventory,
# and only the configurations given on the command line are kept (memory independent of the inventory size)
function load_inventory(   arg, wanted_name, wanted, wanted_left, inventory_line, inventory_name) {
    inventory_loaded = 1
    inventory_exists = 0
    for (arg = 1; arg < ARGC; arg++) {
        wanted_name = ARGV[arg]
        sub(/^.*\//, "", wanted_name)
        wanted[wanted_name] = 1
    }
    wanted_left = length(wanted)
    while (wanted_left > 0 && (getline inventory_line < inventory_file) > 0) {
        inventory_exists = 1
        inventory_name = inventory_line
        sub(/ .*/, "", inventory_name)
        if ((inventory_name in wanted) && !(inventory_name in inventory)) {
            inventory[inventory_name] = substr(inventory_line, length(inventory_name) + 2)
            wanted_left--
        }
    }
    close(inventory_file)
    if (!inventory_exists && system("test -f " shell_quote(inventory_file)) == 0) inventory_exists = 1
}

# --------------------------------------

BEGIN {
    # Load configuration
    load_psirt_config();
    psirt_config_error = check_psirt_config();
    for (i in OS_CMP) os_cmp_count++
    inventory_file = "database/psirt_scopes/psirt_CAWK_PSIRT_OS_inventory_scope.txt"
}

BEGINFILE {

    # Auto-detect OS device from inventory file
    config_file = FILENAME
    if (match(config_file, /([^\/]+)$/, filename_arr)) {
        filename_only = filename_arr[1]
    } else {
        filename_only = config_file
    }

    psirt_inventory_file_error = 0

    if (psirt_config_error != "") {
        print_err("CAWK_PSIRT_TESTNAME.gawk","invalid psirt configuration: " psirt_config_error, FNR, "high", "error");
        psirt_inventory_file_error = 1
        nextfile
    }

    # Enforce that filename matches DEVICE (regex)
    if (!match(filename_only, DEVICE)) {
        print_err("CAWK_PSIRT_TESTNAME.gawk","skipped configuration because filename " filename_only " does not match device pattern " DEVICE, FNR, "medium", "psirt");
        psirt_inventory_file_error = 1
        nextfile
    }

    if (!inventory_loaded) load_inventory()
    if (!inventory_exists) {
        print_err("CAWK_PSIRT_TESTNAME.gawk","skipped because inventory file " inventory_file " does not exist", FNR, "medium", "psirt");
        psirt_inventory_file_error = 1
        nextfile
    }

    # exact match on the file name : no regex, no shell
    if (filename_only in inventory) {
        os_device = inventory[filename_only]
    } else {
        print_err("CAWK_PSIRT_TESTNAME.gawk","skipped configuration because not found in " inventory_file, FNR, "medium", "psirt");
        psirt_inventory_file_error = 1
        nextfile
    }

    # Convert user arrays to internal format
    os_psirt_patterns_count = 0
    for (i in OS) { 
        os_psirt_patterns_count++
        os_psirt_patterns[os_psirt_patterns_count] = OS[i]
    }
    
    config_psirt_line_patterns_count = 0
    for (i in LINE) {
        config_psirt_line_patterns_count++
        config_psirt_line_patterns[config_psirt_line_patterns_count] = LINE[i]
    }
    
    config_psirt_block_patterns_count = 0
    for (i in BLOCK) {
        config_psirt_block_patterns_count++
        config_psirt_block_patterns[config_psirt_block_patterns_count]["start"] = BLOCK[i]["start"]
        config_psirt_block_patterns[config_psirt_block_patterns_count]["end"] = BLOCK[i]["end"]
        
        lines_count = 0
        for (j in BLOCK[i]["match"]) {
            lines_count++
            config_psirt_block_patterns[config_psirt_block_patterns_count]["lines"][lines_count] = BLOCK[i]["match"][j]
        }
        config_psirt_block_patterns[config_psirt_block_patterns_count]["lines_count"] = lines_count
    }
    
    # Convert LOGIC to internal format
    binary_logic = LOGIC

    for (i in BLOCK) {
        # Individual block lines
        for (j in BLOCK[i]["match"]) {
            line_ref = "BLOCK_LINE\\[" i "\\]\\[" j "\\]"
            gsub(line_ref, "config_psirt_block_patterns_lines_matched[" i "][" j "]", binary_logic)
        }
    }

    for (i in BLOCK) {
        # Block = block existence (start + end), not the lines
        ref = "BLOCK\\[" i "\\]"
        gsub(ref, "config_psirt_block_exists[" i "]", binary_logic)
    }

    for (i in LINE) {
        ref = "LINE\\[" i "\\]"
        gsub(ref, "config_psirt_line_patterns_matched[" i "]", binary_logic)
    }

    # Tracking variables
    current_block = 0
    in_block = 0
    psirt_first_match_line = 0

    # Initialize pattern match tracking arrays
    for (i = 1; i <= config_psirt_line_patterns_count; i++) {
        config_psirt_line_patterns_matched[i] = 0
    }
    
    # Initialize block tracking arrays
    for (i = 1; i <= config_psirt_block_patterns_count; i++) {
        config_psirt_block_exists[i] = 0  # Track block existence
        
        # Use separate array for individual line tracking
        for (j = 1; j <= config_psirt_block_patterns[i]["lines_count"]; j++) {
            config_psirt_block_patterns_lines_matched[i][j] = 0
        }
    }
}

# --------------------------------------

{
    config_line = $0
    block_started = 0
    
    # Check simple line patterns
    for (i = 1; i <= config_psirt_line_patterns_count; i++) {
        if (config_psirt_line_patterns[i] != "" && match(config_line, config_psirt_line_patterns[i])) {
            config_psirt_line_patterns_matched[i] = 1
            if (!psirt_first_match_line) psirt_first_match_line = FNR
        }
    }
    
    # Process configuration blocks - INLINE LOGIC
    # Check if we're entering a new block
    if (!in_block) {
        for (i = 1; i <= config_psirt_block_patterns_count; i++) {
            if (match(config_line, config_psirt_block_patterns[i]["start"])) {
                in_block = 1
                current_block = i
                block_started = 1
                if (!psirt_first_match_line) psirt_first_match_line = FNR
                break
            }
        }
    }
    
    # If we're in a block, check for end or internal patterns
    if (in_block && current_block > 0) {
        # Check if it's the end of the block
        if (match(config_line, config_psirt_block_patterns[current_block]["end"])) {
            # Mark that the block exists (start + end found)
            config_psirt_block_exists[current_block] = 1

            # Reset block variables
            in_block = 0
            current_block = 0
        } else if (!block_started) {
            # Check line patterns within the current block AND track individual lines (not on the start line itself)
            for (j = 1; j <= config_psirt_block_patterns[current_block]["lines_count"]; j++) {
                if (match(config_line, config_psirt_block_patterns[current_block]["lines"][j])) {
                    # Track individual line matches in separate array
                    config_psirt_block_patterns_lines_matched[current_block][j] = 1
                }
            }
        }
    }
}

ENDFILE {

    # Risk levels of the psirt status :
    #   high   = vulnerable (configuration logic and OS pattern matched)
    #   low    = OS pattern matched but configuration logic not matched (version in scope, not exposed)
    #   info   = not vulnerable (OS pattern not matched)
    #   medium = skipped, no information (device pattern, inventory file, inventory entry or os_device format)

    # Check logic binary, the OS patterns are checked whatever the logic result
    final_vulnerability_detected = 0
    os_pattern_matched = 0
    matched_os_pattern = ""
    os_format_ok = 0
    if (psirt_inventory_file_error == 0) {
        final_vulnerability_detected = eval_binary_logic(binary_logic)

        split(os_device, target_parts, " ")
        os_format_ok = (length(target_parts) >= 3)
        if (!os_format_ok) {
            print_err("CAWK_PSIRT_TESTNAME.gawk","skipped because Invalid os_device format detected: "os_device, FNR, "medium", "psirt");
        } else {
            # the whole inventory value is matched (the chassis may contain spaces)
            target_full = target_parts[1]
            for (i = 2; i in target_parts; i++) target_full = target_full " " target_parts[i]

            for (i = 1; i <= os_psirt_patterns_count; i++) {
                if (match(target_full, os_psirt_patterns[i])) {
                    os_pattern_matched = 1
                    matched_os_pattern = os_psirt_patterns[i]
                    break
                }
            }

            # version comparisons : the first field of the inventory value is the version, the rest is the platform
            platform = substr(target_full, length(target_parts[1]) + 2)
            for (i = 1; !os_pattern_matched && i <= os_cmp_count; i++) {
                if (os_cmp_match(target_parts[1], platform, i)) {
                    os_pattern_matched = 1
                    matched_os_pattern = "version " OS_CMP[i]["op"] " " OS_CMP[i]["min"]
                    if (OS_CMP[i]["op"] == "between") matched_os_pattern = matched_os_pattern " .. " OS_CMP[i]["max"]
                    if ("platform" in OS_CMP[i]) matched_os_pattern = matched_os_pattern " platform " OS_CMP[i]["platform"]
                }
            }
        }
    }

    if (os_format_ok) {

        psirt_final_match = "";
        if (final_vulnerability_detected && os_pattern_matched) {

            psirt_final_match = "vulnerable to this psirt {FILE_PATTERN=" DEVICE "} {OS_PATTERN=" matched_os_pattern "}";
        
            # Display line existence
            for (i = 1; i <= config_psirt_line_patterns_count; i++) {
                if (config_psirt_line_patterns[i] != "") {
                    psirt_final_match = psirt_final_match" {LINE["i"]="config_psirt_line_patterns[i]" / "config_psirt_line_patterns_matched[i]"}";
                }
            }
            
            # Display block existence
            for (i = 1; i <= config_psirt_block_patterns_count; i++) {
                psirt_final_match = psirt_final_match" {BLOCK["i"][\"start\"]="BLOCK[i]["start"]" / "config_psirt_block_exists[i];
                for (j = 1; j <= config_psirt_block_patterns[i]["lines_count"]; j++) {
                    psirt_final_match = psirt_final_match" "config_psirt_block_patterns_lines_matched[i][j];
                }
                psirt_final_match = psirt_final_match"}"
            }

            print_err("CAWK_PSIRT_TESTNAME.gawk",psirt_final_match,psirt_first_match_line,"high","psirt");

        } else if (final_vulnerability_detected) {
            print_err("CAWK_PSIRT_TESTNAME.gawk","not vulnerable to this psirt (OS pattern not matched)",FNR,"info","psirt");
        } else if (os_pattern_matched) {
            print_err("CAWK_PSIRT_TESTNAME.gawk","OS pattern matched but not exposed (line and block not matched) {OS_PATTERN=" matched_os_pattern "}",FNR,"low","psirt");
        } else {
            print_err("CAWK_PSIRT_TESTNAME.gawk","not vulnerable to this psirt (line and block not matched)",FNR,"info","psirt");
        }
    }
}

# --------------------------------------

END {
}

