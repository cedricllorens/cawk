#
# it generates the makefile to parse configurations in parallel
# ------------------------------------------------------------

function help() {
    print "Usage: generate_makefile.awk file_list files_per_target file_pgm"
}

BEGIN {

    # ------------------
    # ARGC entries -----
    # ------------------

    if (ARGC != 4) {
	help();
	print "cawk error gen_cawk_makefile: 3 arguments expected";
        exit 1;
    }

    file_list = ARGV[1]
    files_per_target = ARGV[2]
    file_pgm = ARGV[3]

    # check entries

    if (system("test -f " file_list) != 0) {
	help();
        print "cawk error gen_cawk_makefile: " file_list " is not a file";
	exit 1;
    }

    if (system("test -f " file_pgm) != 0) {
	help();
        print "cawk error gen_cawk_makefile: " file_pgm " is not a file";
	exit 1;
    }

    if ( files_per_target == 0 ) {
	help();
	print "cawk error gen_cawk_makefile: files_per_target must not be 0";
	exit 1;
    }

    # store entries in tab

    while ((getline < file_list) > 0) {
        files[++total_files] = $0
    }
    close(file_list)

    while ((getline < file_pgm) > 0) {
        pgms[++total_pgm] = $0
    }
    close(file_pgm)

    targets = total_files / files_per_target
    remainder = total_files % files_per_target

    if (remainder > 0) {
        targets++
    }

    # -------------------
    # BUILD all temp vars
    # -------------------
    # one directory per generated makefile: concurrent makefiles (one per supplier) must never remove each other's files
    if ( targets >= 1 ) {
        printf("tmpdir := $(shell mktemp -d -p tmp)\n");
    }
    printf("\n");

    # ----------------
    # BUILD all target
    # ----------------

    printf("all: ");
    if ( targets >= 1 ) {
    	for (t = 1; t <= targets; t++) {
    		for (k = 1; k <= total_pgm ; k++) {
       	 		printf("target%s_%s ",t,k);
		}
    	}
    	printf("\n");
    	printf("\t@find $(tmpdir) -type f -exec cat {} + | sort | uniq");
   	printf("\n");
    	printf("\t@rm -rf $(tmpdir)");
    }
    printf("\n");
    printf("\n");

    # -----------------
    # BUILD sub targets
    # -----------------

    compteur = 1;
    for (i = 1; i <= targets; i++) {
    	for (k = 1; k <= total_pgm ; k++) {
        	printf("\ntarget%s_%s:",i,k);
    		printf("\n\t@touch $(tmpdir)/%s_%s",i,k);
        	printf("\n\t@%s ",pgms[k]);
    		for (j = compteur; j < compteur + files_per_target; j++) {
        		printf("%s ",files[j]);
		}
    		printf(">> $(tmpdir)/%s_%s",i,k);
		printf("\n");
	}
	compteur = compteur + files_per_target;
    }
    printf("\n");

    # -------------------
    # BUILD PHONY targets
    # -------------------

    printf(".PHONY: all ");
    for (t = 1; t <= targets; t++) {
        for (k = 1; k <= total_pgm ; k++) {
            printf("target%s_%s ",t,k);
        }
    }
    printf("\n");
}
