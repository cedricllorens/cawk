#
# for %SED_VAR% change like SED_GAWK_PATH, etc. please refer to
# file support/tests.sed for further information
#
# this script detects configurations in windows format (CRLF)
# Such a configuration is called a crlf configuration
#
# a trailing '\r' defeats the '$'-anchored test regexes, so every
# test result on such a configuration is unreliable
#
# usage: crlf_cawk_conf.gawk conf_file [conf_file ...]
# output: one line per crlf file (first CRLF line + count)
# ------------------------------------------------------------

BEGINFILE {
	crlf_line_count = 0;
	first_crlf_line_number = 0;
}

/\r$/ {
	crlf_line_count++;
	if (first_crlf_line_number == 0)
		first_crlf_line_number = FNR;
}

ENDFILE {
	if (crlf_line_count > 0)
		print FILENAME ";cawk_crlf_internal_test;windows format (CRLF): " crlf_line_count " line(s), convert to unix format (LF);" first_crlf_line_number ";info;error";
}
