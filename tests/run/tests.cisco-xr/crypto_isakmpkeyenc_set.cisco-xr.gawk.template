#
# @test_name : crypto_isakmpkeyenc_set.cisco-xr.gawk
# @supplier : cisco-xr
# @purpose : check if <crypto isakmp key> encryption is set
# @description : ISAKMP pre-shared keys stored in cleartext expose key material in the configuration file, keys must be stored using type 6 password encryption
# @actions : enable password encryption (<key config-key password-encrypt> and <password encryption aes>) so ISAKMP pre-shared keys are stored encrypted (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : SC-13 | System and Communications Protection | Ensure cryptographic protection using approved algorithms is configured
# @risk_level : high
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
}

BEGINFILE {
	pass = 1;
}

/^crypto isakmp key / {
	if ( $0 !~ /^crypto isakmp key 6 .*$/ ) {
		print_err("crypto_isakmpkeyenc_set.cisco-xr.gawk",$0,FNR,"high","error");
		pass = 0;
	}
}

ENDFILE {
	if ( pass ) print_err("crypto_isakmpkeyenc_set.cisco-xr.gawk","<crypto isakmp key> encryption is set",0,"high","pass");
}

END {
}
