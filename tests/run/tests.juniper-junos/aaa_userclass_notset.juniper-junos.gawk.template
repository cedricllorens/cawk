#
# @test_name : aaa_userclass_notset.juniper-junos.gawk
# @supplier : juniper-junos
# @purpose : check that user class is implemented in user block
# @description : all users must have an explicitly assigned class to define role-based access control and enforce least-privilege
# @actions : assign appropriate class to each user (admin, operator, viewer, etc.) to enforce role-based access control
# @nist800-53_ref : AC-2 | Access Control | Ensure account management is implemented
# @risk_level : medium
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
}

BEGINFILE {
	pass = 1;
	block_system = 0;
	block_login = 0;
	block_user = 0;
	user_name = "";
}

/^system {/ && block_system == 0 {
	block_system = 1;
	block_login = 0;
	next;
}

/^%SED_BK_JUNI%login/ && block_system == 1 {
	block_login = 1;
	next;
}

/^%SED_BK_JUNI%{2}user / && block_login == 1 && block_user == 0 {
	block_user = 1;
	match($0, /user ([^ {]+)/, arr);
	user_name = arr[1];
	user_has_class = 0;
	next;
}

/^%SED_BK_JUNI%{3}class / && block_user == 1 {
	user_has_class = 1;
	next;
}

/^%SED_BK_JUNI%{2}}$/ && block_user == 1 {
	if (!user_has_class) {
		print_err("aaa_userclass_notset.juniper-junos.gawk","user " user_name " has no class assigned",FNR,"medium","error");
		pass = 0;
	}
	block_user = 0;
	next;
}

/^%SED_BK_JUNI%}$/ && block_login == 1 {
	block_login = 0;
}

/^}$/ && block_system == 1 {
	block_system = 0;
}

ENDFILE {
	if (pass) print_err("aaa_userclass_notset.juniper-junos.gawk","all users have class assigned",0,"medium","pass");
}

END {
}
