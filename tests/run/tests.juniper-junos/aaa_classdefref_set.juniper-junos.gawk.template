#
# @test_name : aaa_classdefref_set.juniper-junos.gawk
# @supplier : juniper-junos
# @purpose : check that login classes are defined and referenced by users
# @description : login classes must be referenced by at least one user (unused classes indicate configuration drift) and users must reference existing classes (missing class is a security risk)
# @actions : remove unused login classes and ensure all users reference a valid defined class
# @nist800-53_ref : AC-2 | Access Control | Ensure account management is implemented
# @risk_level : high | info
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
}

BEGINFILE {
	pass = 1;
	block_system = 0;
	block_login = 0;
	block_user = 0;
	delete class_defined;
	delete class_defined_line;
	delete class_referenced;
}

/^system {/ && block_system == 0 {
	block_system = 1;
	block_login = 0;
	next;
}

/^%SED_BK_JUNI%login/ && block_system == 1 {
	block_login = 1;
	next;
}

# collect defined classes
/^%SED_BK_JUNI%{2}class / && block_login == 1 {
	match($0, /class ([^ {]+)/, arr);
	class_defined[arr[1]] = 1;
	class_defined_line[arr[1]] = FNR;
	next;
}

# collect class references from user blocks
/^%SED_BK_JUNI%{2}user / && block_login == 1 {
	block_user = 1;
	next;
}

/^%SED_BK_JUNI%{3}class / && block_user == 1 && !/class (unauthorized|none|super-user|operator|read-only)( |;|$)/ && !/inactive/ {
	match($0, /class ([^ ;]+)/, arr);
	class_referenced[arr[1]] = 1;
	next;
}

/^%SED_BK_JUNI%{2}}$/ && block_user == 1 {
	block_user = 0;
	next;
}

/^%SED_BK_JUNI%}$/ && block_login == 1 {
	block_login = 0;
}

/^}$/ && block_system == 1 {
	block_system = 0;
}

ENDFILE {
	# class defined but not referenced by any user
	for (c in class_defined) {
		if (!(c in class_referenced)) {
			print_err("aaa_classdefref_set.juniper-junos.gawk","class " c " defined but not referenced by any user",class_defined_line[c],"info","error");
			pass = 0;
		}
	}
	# user references a class that is not defined
	for (c in class_referenced) {
		if (!(c in class_defined)) {
			print_err("aaa_classdefref_set.juniper-junos.gawk","class " c " referenced by user but not defined",0,"high","error");
			pass = 0;
		}
	}
	if (pass) print_err("aaa_classdefref_set.juniper-junos.gawk","all login classes are defined and referenced",0,"high","pass");
}

END {
}
