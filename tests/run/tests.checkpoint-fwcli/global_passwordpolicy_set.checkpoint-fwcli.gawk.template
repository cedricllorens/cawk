#
# @test_name : global_passwordpolicy_set.checkpoint-fwcli.gawk
# @supplier : checkpoint-fwcli
# @purpose : check that <password policy> is set
# @description : weak password policies increase the risk of unauthorized access through brute force or credential attacks
# @actions : missing statements should be added to the configuration or setup exceptions (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : IA-5(1) | Identification and Authentication | Ensure password-based authentication complexity is enforced
# @risk_level : medium
# @authors : maxime souris
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
    # password policy rules 
    PWD_MIN_LEN = 15
    PWD_COMPLEXITY = "high"
    PWD_HISTORY = 5
}

BEGINFILE {
    seen_length = 0;
    seen_complexity = 0;
    seen_history = 0;
}

# ----

/^set password-policy min-length .*/ && $4 < PWD_MIN_LEN {
    print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy length is too short <<"$0">>",FNR,"medium","error");
    seen_length = 1;
    next;
}

/^set password-policy min-length .*/ && $4 >= PWD_MIN_LEN {
    print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy length is correct <<"$0">>",FNR,"medium","pass");
    seen_length = 1;
    next;
}

# ----

/^set password-policy complexity .*/ && $4 != PWD_COMPLEXITY {
    seen_complexity = 1;
    if ( $4 !~ /^(low|medium|high)$/ ) {
        print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy complexity unknown <<"$0">>",FNR,"medium","error");
    } else {
        print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy complexity not strong enough <<"$0">>",FNR,"medium","error");
    }
    next;
}

/^set password-policy complexity .*/ && $4 == PWD_COMPLEXITY {
    print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy complexity is correct <<"$0">>",FNR,"medium","pass");
    seen_complexity = 1;
    next;
}

# ----

/^set password-policy history .*/ && $4 != PWD_HISTORY {
    print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy incorrect history checking <<"$0">>",FNR,"medium","error");
    seen_history = 1;
    next;
}

/^set password-policy history .*/ && $4 == PWD_HISTORY {
    print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy correct history checking <<"$0">>",FNR,"medium","pass");
    seen_history = 1;
    next;
}

ENDFILE {
    if ( !seen_length ) print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy min-length not configured",0,"medium","error");
    if ( !seen_complexity ) print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy complexity not configured",0,"medium","error");
    if ( !seen_history ) print_err("global_passwordpolicy_set.checkpoint-fwcli.gawk","password policy history not configured",0,"medium","error");
}

END {
}

