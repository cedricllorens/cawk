#
# @test_name : acl_configconsistency_set.huawei-vrp.gawk
# @supplier : huawei-vrp
# @purpose : check that <ip acl number standard ...> have inconsistent/redundant rules
# @description : inconsistent or redundant acl rules reduce security effectiveness and complicate policy management
# @actions : review and clean up acl rules to remove redundancies and resolve inconsistencies (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : SI-2 | System and Information Integrity | Ensure flaw remediation and patching is configured
# @risk_level : info
# @authors : cedric llorens
# ------------------------------------------------------------

# rule format ----------------------------------
# 1  rule_name          : string
# 2  rule_description   : string
# 3  action             : permit/deny
# 4  ingress/outgress   : "none","in","out","all"
# 5  interface          : "none",string
# 6  family             : "all", inet, inet6
# 7  src@               : ip
# 8  src_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
# 9  port_src           : port_src			set 0 if empty
# 10 port_src_range     : port_src_range	set 0 if empty
# 11 dst@               : ip				set 0 if empty
# 12 dst_net@           : cird/netmask		set "none","host","any",[0-9]+,[0-9]+.[0-9]+.[0-9]+.[0-9]+
# 13 port_dst           : port_dst			set 0 if empty
# 14 port_dst_range     : port_dst_range	set 0 if empty
# 15 protocol           : protocol			set "none" if empty
# rule format ----------------------------------

@include %SED_INCLUDE_PATH%
@include %SED_INCLUDE_PATH_FWLIB%

BEGIN {
	# icmp-type keywords as "type/code"
	split("echo 8 echo-reply 0 fragmentneed-DFset 3/4 host-redirect 5/1 host-tos-redirect 5/3 host-unreachable 3/1 information-reply 16/0 information-request 15/0 net-redirect 5/0 net-tos-redirect 5/2 net-unreachable 3/0 parameter-problem 12/0 port-unreachable 3/3 protocol-unreachable 3/2 reassembly-timeout 11/1 source-quench 4/0 source-route-failed 3/5 timestamp-reply 14/0 timestamp-request 13/0 ttl-exceeded 11/0", hw_kw, " ");
	for ( kw_i = 1; kw_i in hw_kw; kw_i += 2 ) hw_icmp_names[hw_kw[kw_i]] = hw_kw[kw_i+1];
}

# icmp message after "icmp-type" at field pos (keyword or "type [code]"), empty for any message
function huawei_icmp_type(pos) {
	if ( $pos in hw_icmp_names ) return hw_icmp_names[$pos];
	if ( $pos ~ /^[0-9]+$/ ) return ( $(pos+1) ~ /^[0-9]+$/ ) ? $pos"/"$(pos+1) : $pos;
	return "";
}

BEGINFILE {
	cawk_init_hypercube_rules();
	block_acl = 0;
	valid_acl = 0;
	acl = "";
	check = 0;
}

/^acl number [^ ]+$/ {
	check = 1;
	if ( acl != $3 && acl != "" ) {
		if ( cawk_hypercube_rules_assessment() ) {
			print_err("acl_configconsistency_set.huawei-vrp.gawk","acl number "acl" has no redundant/inconsistent rules",FNR,"info","pass");
		}
		cawk_init_hypercube_rules();
	}
	acl = $3;
	block_acl = 1;
	valid_acl = 0;
}

# --------

# parse "<operator> <value> [<value>]" (eq|range|gt|lt) starting at field pos
# sets hw_port/hw_port_range and returns the number of fields consumed
function huawei_port(pos) {
	hw_port_value = ($(pos+1) in table_port) ? table_port[$(pos+1)] : $(pos+1);
	if ( $(pos) == "range" ) {
		hw_port = int(hw_port_value);
		hw_port_range = ($(pos+2) in table_port) ? table_port[$(pos+2)] : $(pos+2);
		return 3;
	} else if ( $(pos) == "gt" ) {
		hw_port = hw_port_value + 1;
		hw_port_range = 65535;
	} else if ( $(pos) == "lt" ) {
		hw_port = 0;
		hw_port_range = hw_port_value - 1;
	} else {
		hw_port = hw_port_value;
		hw_port_range = 0;
	}
	return 2;
}

/^[ ]rule[ ][0-9]+ (permit|deny) .*$/ && block_acl == 1 {
	rule_desc = "rule_line_"FNR" <"$0">";

	# action ----
	local_action = $3;
	local_current = 3;
	local_current = local_current + 1;

	# protocol ---- (optional: a basic acl rule goes straight to "source")
	if ( $(local_current) != "" && $(local_current) !~ /^(source|destination|source-port|destination-port)$/ ) {
		
		if (  $(local_current) == "ip" ) {
			local_protocol = "none";
		} else {
			local_protocol = $(local_current);
		}
		local_current = local_current + 1;

	} else {

		local_protocol = "none";

	}

	# source ----
	local_src = "any"
	local_src_net = "any"

	if ( $(local_current) == "source" ) {

		valid_acl = 1;

		local_src = $(local_current+1);
		if ( $(local_current+1) == "any") {
			local_src_net = "any";
			local_current = local_current + 2;
		} else if ( $(local_current+2) !~ /^[0-9\.]+$/ ) {
			local_src_net = "host";
			local_current = local_current + 2;
		} else if ( $(local_current+2) == "0" ) {
			local_src_net = "host";
			local_current = local_current + 3;
		} else {
			local_src_net = cawk_netMaskInv($(local_current+2))
			local_current = local_current + 3;
		}
	
	}

	# source-port ----
	local_src_port = 0
	local_src_port_range = 0

	if ( $(local_current) == "source-port" ) {

		valid_acl = 1;

		local_current = local_current + 1 + huawei_port(local_current+1);
		local_src_port = hw_port;
		local_src_port_range = hw_port_range;
	
	}

	# destination ----
	local_dst = "any"
	local_dst_net = "any"

	if ( $(local_current) == "destination" ) {

		valid_acl = 1;

		local_dst = $(local_current+1);
		if ( $(local_current+1) == "any") {
			local_dst_net = "any";
			local_current = local_current + 2;
		} else if ( $(local_current+2) !~ /^[0-9\.]+$/ ) {
			local_dst_net = "host";
			local_current = local_current + 2;
		} else if ( $(local_current+2) == "0" ) {
			local_dst_net = "host";
			local_current = local_current + 3;
		} else {
			local_dst_net = cawk_netMaskInv($(local_current+2));
			local_current = local_current + 3;
		}
	
	}

	# destination-port ----
	local_dst_port = 0
	local_dst_port_range = 0

	if ( $(local_current) == "destination-port" ) {

		valid_acl = 1;

		local_current = local_current + 1 + huawei_port(local_current+1);
		local_dst_port = hw_port;
		local_dst_port_range = hw_port_range;
	
	}

	# icmp message ----
	local_icmp = "";
	for ( icmp_f = local_current; icmp_f <= NF; icmp_f++ ) {
		if ( $icmp_f == "icmp-type" ) {
			local_icmp = huawei_icmp_type(icmp_f + 1);
			break;
		}
	}

	if ( valid_acl ) cawk_add_hypercube_rules("acl_configconsistency_set.huawei-vrp.gawk","acl number "acl" "rule_desc,local_action,"none","none","all",local_src,local_src_net,local_src_port,local_src_port_range,local_dst,local_dst_net,local_dst_port,local_dst_port_range,local_protocol,local_icmp)
	next;
}

/^#$/ && block_acl == 1 {

	if ( cawk_hypercube_rules_assessment() ) {
		print_err("acl_configconsistency_set.huawei-vrp.gawk","acl number "acl" has no redundant/inconsistent rules",FNR,"info","pass");
	}

	cawk_init_hypercube_rules();
	block_acl = 0;
	acl = "";
	valid_acl = 0;
}

ENDFILE { 
	# the last acl is not assessed when the file ends without its terminator line
	if ( acl != "" && cawk_hypercube_rules_assessment() ) {
		print_err("acl_configconsistency_set.huawei-vrp.gawk","acl number "acl" has no redundant/inconsistent rules",FNR,"info","pass");
	}
	if ( check == 0 ) print_err("acl_configconsistency_set.huawei-vrp.gawk","no <acl number [0-9]*> found",FNR,"info","pass");
}
