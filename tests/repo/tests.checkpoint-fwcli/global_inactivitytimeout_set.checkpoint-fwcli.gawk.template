#
# @test_name : global_inactivitytimeout_set.checkpoint-fwcli.gawk
# @supplier : checkpoint-fwcli
# @purpose : check that <inactivity-timeout> and <web session-timeout> are set to a safe value
# @description : a disabled or excessive idle timeout leaves unattended clish and WebUI administrative sessions open and exploitable; CIS Gaia benchmark recommends 10 minutes or less
# @actions : set inactivity-timeout and web session-timeout to 10 minutes or less (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : AC-11 | Access Control | Ensure device lock after inactivity timeout is configured
# @risk_level : medium
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

# local functions ----
function checktimeout(value, line) {
    # CIS Gaia recommends <= 10 minutes; above 30 or disabled is an error
    if ( value == 0 || value > 30 ) {
        print_err("global_inactivitytimeout_set.checkpoint-fwcli.gawk","unsafe idle timeout value <<"line">>",FNR,"medium","error");
    } else if ( value > 10 ) {
        print_err("global_inactivitytimeout_set.checkpoint-fwcli.gawk","idle timeout exceeds CIS recommended 10 minutes <<"line">>",FNR,"medium","warning");
    } else {
        print_err("global_inactivitytimeout_set.checkpoint-fwcli.gawk","idle timeout set <<"line">>",FNR,"medium","pass");
    }
}
# local functions ----

BEGIN {
}

BEGINFILE {
    timeout_seen = 0;
}

/^set inactivity-timeout / {
    timeout_seen = 1;
    checktimeout($NF + 0, $0);
    next;
}

/^set web session-timeout / {
    timeout_seen = 1;
    checktimeout($NF + 0, $0);
    next;
}

ENDFILE {
    if ( !timeout_seen ) {
        print_err("global_inactivitytimeout_set.checkpoint-fwcli.gawk","inactivity-timeout not explicitly set (vendor default 120 minutes applies)",0,"medium","warning");
    }
}

END {
}
