#
# @test_name : global_remotesyslog_set.checkpoint-fwcli.gawk
# @supplier : checkpoint-fwcli
# @purpose : check <syslog log-remote-address> is set
# @description : without a remote syslog server local logs can be lost or tampered with after a compromise, centralized log retention supports investigations, regulatory audits and compliance evidence
# @actions : add syslog log-remote-address pointing to a centralized log server (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : AU-4 | Audit and Accountability | Ensure audit log storage capacity is configured
# @risk_level : medium
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
}

BEGINFILE {
    syslog_seen = 0;
}

/^add syslog log-remote-address / {
    syslog_seen = 1;
    syslog_address = $4;
    if ( syslog_address ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/ || syslog_address ~ /\$\w+/ ) {
        print_err("global_remotesyslog_set.checkpoint-fwcli.gawk","remote syslog server set <<"$0">>",FNR,"medium","pass");
    } else {
        print_err("global_remotesyslog_set.checkpoint-fwcli.gawk","remote syslog server with a bad address <<"$0">>",FNR,"medium","error");
    }
    next;
}

ENDFILE {
    if ( !syslog_seen ) {
        print_err("global_remotesyslog_set.checkpoint-fwcli.gawk","no remote syslog server configured",0,"medium","error");
    }
}

END {
}
