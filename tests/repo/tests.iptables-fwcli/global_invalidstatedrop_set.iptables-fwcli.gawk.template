#
# @test_name : global_invalidstatedrop_set.iptables-fwcli.gawk
# @supplier : iptables-fwcli
# @purpose : check that <INVALID state> packets are dropped
# @description : packets in invalid connection state (malformed or out-of-state) can be used for evasion or scanning if not explicitly dropped
# @actions : add a rule dropping packets with conntrack state INVALID (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : SC-7 | System and Communications Protection | Ensure boundary protection is configured
# @risk_level : medium
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
}

BEGINFILE {
    invalid_drop = 0;
    invalid_other = 0;
}

# invalid state dropped ----
/^iptables .*(--ctstate|--state) INVALID .*-j DROP/ {
    invalid_drop = 1;
    print_err("global_invalidstatedrop_set.iptables-fwcli.gawk","invalid state drop rule found <<"$0">>",FNR,"medium","pass");
    next;
}

# invalid state matched but not dropped ----
/^iptables .*(--ctstate|--state) INVALID / {
    invalid_other = 1;
    next;
}

ENDFILE {
    if ( !invalid_drop && invalid_other ) {
        print_err("global_invalidstatedrop_set.iptables-fwcli.gawk","invalid state matched but never dropped",0,"medium","error");
    } else if ( !invalid_drop && !invalid_other ) {
        print_err("global_invalidstatedrop_set.iptables-fwcli.gawk","no invalid state drop rule found",0,"medium","error");
    }
}

END {
}
