#
# @test_name : global_passwordpolicy_set.fortinet-fortios.gawk
# @supplier : fortinet-fortios
# @purpose : check that <system password-policy> is enabled with a sufficient minimum length
# @description : without an enabled password policy weak administrator passwords are accepted, increasing the risk of brute force and credential attacks
# @actions : enable config system password-policy with minimum-length 8 or more (please refer to engineering/operations guidelines for further information)
# @nist800-53_ref : IA-5(1) | Identification and Authentication | Ensure password-based authentication complexity is enforced
# @risk_level : medium
# @authors : cedric llorens
# ------------------------------------------------------------

@include %SED_INCLUDE_PATH%

BEGIN {
    PWD_MIN_LEN = 8;
}

BEGINFILE {
    block_policy = 0;
    policy_enabled = 0;
    minlen_line = "";
    minlen_value = 0;
}

/^config system password-policy/ {
    block_policy = 1;
    next;
}

/^%SED_BK_FORTI%set status enable/ && block_policy == 1 {
    policy_enabled = 1;
    next;
}

/^%SED_BK_FORTI%set minimum-length / && block_policy == 1 {
    minlen_value = $NF + 0;
    minlen_line = $0;
    next;
}

/^end$/ {
    block_policy = 0;
}

ENDFILE {
    if ( !policy_enabled ) {
        print_err("global_passwordpolicy_set.fortinet-fortios.gawk","system password-policy not enabled",0,"medium","error");
    } else if ( minlen_value != 0 && minlen_value < PWD_MIN_LEN ) {
        print_err("global_passwordpolicy_set.fortinet-fortios.gawk","password policy minimum length is too short <<"rm_blank_before(minlen_line)">>",0,"medium","error");
    } else {
        print_err("global_passwordpolicy_set.fortinet-fortios.gawk","system password-policy enabled with sufficient minimum length",0,"medium","pass");
    }
}

END {
}
